{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/registry/effort.json",
  "x-owner": "effort",
  "x-schema-version": 1,
  "description": "The cheapest-useful-effort check (EFFORT-STEP; D-069 items 4, 8 and 9, D-065 (5)): the block a plan and a PR body carry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "effort.fields": {
      "type": "array",
      "default": [
        "Action",
        "Cost",
        "Requirement",
        "Cheaper rejected"
      ],
      "x-unit": "text",
      "description": "The fields of the effort block, one `<field>:` line each; a missing, empty or placeholder field is refused.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "x-readers": [
        "scripts/lib/effort.py"
      ]
    },
    "effort.heading": {
      "type": "string",
      "default": "Cheapest useful effort",
      "x-unit": "text",
      "description": "Heading of the effort block a plan and a PR body carry (EFFORT-STEP, docs/padrao/v4/effort.md).",
      "x-readers": [
        "scripts/lib/effort.py",
        "scripts/lib/intake_templates.py"
      ]
    },
    "effort.machine_words": {
      "type": "array",
      "default": [
        "gate",
        "gates",
        "gate-dev",
        "gate-local",
        "train",
        "test",
        "tests",
        "suite",
        "CI",
        "stage",
        "check",
        "green"
      ],
      "x-unit": "text",
      "description": "Words that name a machine; a requirement that names one of them and no owner is refused with the word.",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "x-readers": [
        "scripts/lib/effort.py"
      ]
    },
    "effort.owner_registry": {
      "type": "string",
      "default": "units.owners",
      "x-unit": "name",
      "description": "Registry list whose entries (the unit lanes, D-067 (2), D-069 item 8) also count as owners.",
      "x-readers": [
        "scripts/lib/effort.py",
        "scripts/lib/pr_body.py"
      ]
    },
    "effort.owners": {
      "type": "array",
      "default": [
        "Daniel",
        "A Torre",
        "coordinator",
        "learner",
        "learners",
        "student",
        "students",
        "reader",
        "readers",
        "user",
        "users",
        "operator",
        "author",
        "reviewer",
        "maintainer"
      ],
      "x-unit": "text",
      "description": "People and roles a requirement may name as the one who needs the result; the lanes come from effort.owner_registry.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "x-readers": [
        "scripts/lib/effort.py",
        "scripts/lib/pr_body.py"
      ]
    },
    "effort.placeholders": {
      "type": "array",
      "default": [
        "none",
        "n/a",
        "na",
        "-",
        "tbd",
        "todo",
        "?",
        "..."
      ],
      "x-unit": "text",
      "description": "Values that count as an empty field (compared case-insensitively, without surrounding backticks, stars and dots).",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "x-readers": [
        "scripts/lib/effort.py"
      ]
    },
    "effort.requirement_field": {
      "type": "string",
      "default": "Requirement",
      "x-unit": "text",
      "description": "The field that must name an owner (effort.owners or a lane of effort.owner_registry), never only a machine.",
      "x-readers": [
        "scripts/lib/effort.py"
      ]
    },
    "effort.rule_doc": {
      "type": "string",
      "default": "docs/padrao/v4/effort.md",
      "x-unit": "path",
      "description": "The rule a refusal cites: what the block is and why.",
      "x-readers": [
        "scripts/lib/effort.py",
        "scripts/lib/pr_body.py"
      ]
    }
  }
}
