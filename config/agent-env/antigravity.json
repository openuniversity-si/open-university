{
  "id": "antigravity",
  "provider": "antigravity",
  "variables": {
    "OU_CREDENTIALS": "network"
  },
  "secrets": [
    {
      "name": "TOWER_PORT_TOKEN",
      "store": "ssm",
      "ref": "/tower/agent-env/antigravity/port-token"
    }
  ],
  "network": {
    "hosts": []
  },
  "starting_credential": {
    "kind": "bearer-env",
    "variable": "TOWER_ANTIGRAVITY_ENV_TOKEN"
  }
}
