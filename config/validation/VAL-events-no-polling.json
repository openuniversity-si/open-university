{
  "id": "VAL-events-no-polling",
  "statement": "No component of the engine polls a state on a fixed interval: no sleep inside a loop is left in its code, outside the tests.",
  "validates": [
    "REQ-events-no-polling"
  ],
  "owner": "administration",
  "measure": {
    "kind": "code-scan",
    "paths": [
      "scripts/**/*",
      "services/**/*",
      "infra/**/*"
    ],
    "exclude": [
      "scripts/tests/**/*",
      "services/**/tests/**/*",
      "infra/**/tests/**/*"
    ]
  },
  "comparator": "lte",
  "threshold": 0
}
