#!/usr/bin/env bash
# Usage: scripts/idea-to-prod [--since YYYY-MM-DD] [--root DIR] [--prs FIXTURE.json] [--now ISO-TIME]
# Idea-to-production report (docs/process/STRUCTURE.md D5): one line per capability in docs/capabilities,
# from its `requested:` to the verified production deploy of the merged PRs whose body says
# `Capability: CAP-NNN`. Computed from the repository and GitHub REST on each run; nothing is written.
set -euo pipefail
exec "${OU_PYTHON:-python3}" "$(dirname "$0")/lib/idea_to_prod.py" "$@"
