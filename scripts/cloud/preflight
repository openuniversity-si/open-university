#!/usr/bin/env bash
# Print every missing toolchain tool, project id and credential. Never prints a secret.
set -euo pipefail
# shellcheck source=scripts/cloud/root-session.sh
source "$(cd "$(dirname "$0")" && pwd)/root-session.sh"
root="$(git rev-parse --show-toplevel)"
cd "$root"
# shellcheck source=scripts/cloud/env.sh
source "$root/scripts/cloud/env.sh"
export PYTHONPATH="$root/scripts/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "${OU_PYTHON:-python3}" "$root/scripts/lib/preflight.py" "$@"
