#!/usr/bin/env bash
# AGENT-ENV (D-341): `scripts/cloud/agent-env fetch` writes what this agent environment declares for the next shell.
# Inert while agent-env.endpoint is empty. Prints names and counts only, never a value; every failure is one line, exit 0.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
export PYTHONPATH="$root/scripts/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "${OU_PYTHON:-python3}" "$root/scripts/lib/agent_env_client.py" "$@"
