#!/usr/bin/env bash
# Usage: scripts/cycle on|off|status
# The SEMENTE cycle marker (.gate/cycle.on, gitignored): while it exists the Stop hook scripts/hooks/cycle-stop blocks
# the end of a turn that is not a closed-list `STOP: <reason>` (I-0d1c3a25). Local only: no network.
set -euo pipefail
exec "${OU_PYTHON:-python3}" "$(dirname "$0")/lib/cycle_stop.py" "$@"
