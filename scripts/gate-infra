#!/usr/bin/env bash
# The gate over the infrastructure (GATE-INFRA 2, P5 F2; D-306): judge a PR head with the infrastructure's jobs, in
# shadow beside the box. scripts/lib/gate_infra.py says how; with no port configured it judges nothing.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
exec "${OU_PYTHON:-python3}" "$root/scripts/lib/gate_infra.py" "$@"
