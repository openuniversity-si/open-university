#!/usr/bin/env bash
# Usage: scripts/model [--help]
# The engineering model (PADRAO-DEV): reads the objects of every system against the metamodel in config/model/, checks types, states and links, shows one object with its links, measures the end-to-end chain, the requirement inventory and each system's conformance, and reports the eight external trust indicators and autonomy ladder (`scripts/model trust`).
set -euo pipefail
if [[ "${1:-}" == "trust" ]]; then
  shift
  exec "${OU_PYTHON:-python3}" "$(dirname "$0")/lib/trust_metrics.py" "$@"
fi
exec "${OU_PYTHON:-python3}" "$(dirname "$0")/lib/model.py" "$@"
