#!/usr/bin/env bash
# Usage: scripts/deploy-smoke [--url URL]
# The post-deploy smoke (DEP7): what must answer after the slow path changed a stack. Run by infra/aws/deploy.sh inside the
# deployer (CodeBuild); red (exit 1) rolls back the stacks that build changed. Three checks, each within a window of
# (DEPLOY_SMOKE_TRIES - 1) x DEPLOY_SMOKE_SLEEP seconds (6 and 5 by default: 25 s) because a stack that just rolled out
# answers late; a failed request is asked again on a backoff (SMOKE-BACKOFF: from 1 s, doubling up to DEPLOY_SMOKE_SLEEP):
#   1. GET /v1/health          200 and "ok":true: the port's Lambda is up and the database answers.
#                              PORT-HEALTH-WAIT: asked with ?wait_s, held by the port until it is ready (no pause between
#                              held answers; an unmarked one, from a port older than the wait, is said and retried)
#   2. GET /v1/deploy/status   the route is alive: 200 with a token, 401/403 without one.
#   3. a registry read         with a token, that status answers source "registry" (read from the log); without, skipped.
# and, with a token, the canary (DEPLOY-CANARY, docs/operations/aws.md 22.3): the three above are all served by the port's
# Lambda, so a deploy that broke the service's dispatch or the runner's take passed them.
#   4. POST /v1/deploy/canary  one job through the path a check takes (tower_infra.canary), idempotent by the build's id;
#      GET /v1/deploy/canary/<id>?wait_s=20, a long poll the job's end wakes (CANARY-HOLDS: held and marked even when its
#      listener cannot open), until the port gives its verdict: green when the job ended well within
#      deploy.canary_limit_s (registry, 120 s), red with the stage that never happened: not dispatched (the service), dispatched and not taken (the runner), taken and failed (the run). A red
#      canary is also published to ALERTS_TOPIC_ARN when the deployer has it. A port with no canary route (a bisection's
#      midpoint older than the route) skips it, and says so.
#      SMOKE-WITHOUT-RUNNER (the migration to GitHub, Torre 14/11): the canary is a check's path, and a check needs the
#      runner (stage take). Once the gate leaves AWS the ECS service tower-runner is stopped (desired count 0) or deleted,
#      and a canary would be red on every deploy and roll it back. DEPLOY_SMOKE_CANARY says when it runs: `auto` (the
#      default) asks ECS for tower-runner in the cluster tower (DEPLOY_SMOKE_RUNNER_CLUSTER, _SERVICE): it runs when the
#      service is ACTIVE with a desired count above 0, it is skipped, and said, when the service is missing, inactive or at
#      0. When ECS does not answer (the deployer's role is not granted it), the runner stack's DesiredCount parameter
#      (DEPLOY_SMOKE_RUNNER_STACK, tower-app-runner) decides the same way, and a stack that does not exist skips it; when
#      neither answers (no credential, a transport failure) it runs, so a doubt never loosens the smoke.
#      `on` always runs it, `off` never (said). Checks 1 to 3 run whatever it says.
# The URL is DEPLOY_SMOKE_URL or the PortUrl output of tower-app-port. The token is DEPLOY_SMOKE_TOKEN or the SecureString
# /tower/deploy/smoke-token (an installation token, inside the /tower/deploy/* read the deployer already has); with none
# the authenticated half is said to be skipped, never silently passed. No secret is printed.
set -u
url="${DEPLOY_SMOKE_URL:-}"
[[ "${1:-}" = --url ]] && url="${2:-}"
tries="${DEPLOY_SMOKE_TRIES:-6}"; pause="${DEPLOY_SMOKE_SLEEP:-5}"
if [[ -z "$url" ]]; then
  url="$(aws cloudformation describe-stacks --stack-name tower-app-port --query 'Stacks[0].Outputs[?OutputKey==`PortUrl`].OutputValue | [0]' --output text 2>/dev/null)"
fi
if [[ -z "$url" || "$url" = None ]]; then echo "smoke RED: no port URL (DEPLOY_SMOKE_URL or the PortUrl output of tower-app-port)"; exit 1; fi
url="${url%/}"
token="${DEPLOY_SMOKE_TOKEN:-}"
[[ -z "$token" ]] && token="$(aws ssm get-parameter --name /tower/deploy/smoke-token --with-decryption --query Parameter.Value --output text 2>/dev/null || true)"
[[ "$token" = None ]] && token=""

# get <path> [auth] [max seconds, 10]: prints "<status> <body>" of one GET, empty status on a transport failure.
get() {
  local args=(-sS -m "${3:-10}" -o "$body" -w '%{http_code}')
  [[ -n "${2:-}" && -n "$token" ]] && args+=(-H "Authorization: Bearer $token")
  curl "${args[@]}" "$url$1" 2>/dev/null || true
}
body="$(mktemp)"; trap 'rm -f "$body"' EXIT

# now_ms: the wall clock in milliseconds (a window's end; SECONDS counts whole seconds, which could end it up to 1 s early).
now_ms() { date +%s%3N; }
ms=1000  # milliseconds in a second

# secs <ms>: those milliseconds as the seconds sleep takes (SMOKE-BACKOFF's pause after a failed request).
secs() { local part=$(( $1 % ms + ms )); echo "$(( $1 / ms )).${part:1}"; }

# check <name> <path> <auth?> <ok-status-regex> <body-regex> [hold]: asked until it passes or its window, (tries - 1) x
# pause (25 s by default), is over: red then, never before it and never later than a retry every pause was.
# PORT-HEALTH-WAIT (hold): asked with ?wait_s=<what is left of the window>; the port holds the call until its database
# answers and marks the answer (long_poll), so a marked answer that is not ok yet is asked again at once, with no pause.
# SMOKE-BACKOFF (PADRAO-DEV F8b): what is left is a failed request: no answer, the gateway's (a 5xx, a 429), a refusal or a
# wrong body, and, with hold, an answer the port did not mark (a port older than PORT-HEALTH-WAIT, which no deploy serves
# since it went live in 1d5693e: said, and failed as an unready port fails, so one that gets ready in time is still green).
# It is asked again after a pause that doubles from 1 s up to pause (never longer than a retry every pause), cut at the
# window's end so the last ask is at that end, and back to 1 s after an answer the port held.
check() {
  local name="$1" path="$2" auth="$3" want="$4" shape="$5" hold="${6:-}" code="" left wait old=""
  local deadline=$(( $(now_ms) + (tries - 1) * pause * ms )) step=$(( pause < 1 ? pause : 1 )) delay
  delay=$step
  while :; do
    left=$(( deadline - $(now_ms) )); (( left > 0 )) || left=0
    if [[ -n "$hold" ]]; then
      wait=$(( (left + ms - 1) / ms ))
      code="$(get "$path?wait_s=$wait" "$auth" $(( wait + 10 )))"
    else
      code="$(get "$path" "$auth")"
    fi
    if [[ "$code" =~ ^($want)$ ]] && { [[ -z "$shape" ]] || grep -Eq "$shape" "$body"; }; then echo "smoke ok: $name ($code)"; return 0; fi
    left=$(( deadline - $(now_ms) ))
    (( left > 0 )) || break
    if [[ -n "$hold" ]] && jq -e 'has("long_poll")' "$body" >/dev/null 2>&1; then delay=$step; continue; fi  # held: at once
    if [[ -n "$hold" && -z "$old" ]] && jq -e '.service == "tower-port" or .error == "unavailable"' "$body" >/dev/null 2>&1; then
      old=1; echo "smoke: $name answered '$code' unmarked: the port did not hold it (older than PORT-HEALTH-WAIT): asked as an unready port"
    fi
    sleep "$(secs $(( delay * ms < left ? delay * ms : left )))"
    (( delay += delay, delay < pause )) || delay=$pause
  done
  echo "smoke RED: $name answered '${code:-no answer}' (wanted $want${shape:+ with $shape}): $(head -c 200 "$body" | tr -d '\000-\037')"
  return 1
}

# canary: DEPLOY-CANARY. One canary job by the port, then its verdict by long poll; 0 green or skipped, 1 red.
canary() {
  local key="${DEPLOY_SMOKE_CANARY_KEY:-${CODEBUILD_BUILD_ID:-smoke-$(date +%s)-$$}}" code id limit ok asked began=$SECONDS
  local step=$(( pause < 1 ? pause : 1 )) delay over
  delay=$step
  code="$(curl -sS -m 30 -o "$body" -w '%{http_code}' -X POST -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -d "$(jq -nc --arg key "$key" '{key: $key}')" "$url/v1/deploy/canary" 2>/dev/null || true)"
  if [[ "$code" = 404 ]]; then echo "smoke: the port has no canary route (code older than DEPLOY-CANARY): the canary job was skipped"; return 0; fi
  id="$(jq -r '.id // empty' "$body" 2>/dev/null)"; limit="$(jq -r '.limit_s // 120 | ceil' "$body" 2>/dev/null)"
  if [[ ! "$code" =~ ^20[01]$ || -z "$id" ]]; then
    echo "smoke RED: canary job not created: POST /v1/deploy/canary answered '${code:-no answer}': $(head -c 200 "$body" | tr -d '\000-\037')"; return 1
  fi
  over=$(( ${limit:-120} + 60 ))  # no verdict this long after the job was made: red
  while :; do
    asked=$SECONDS
    code="$(curl -sS -m 30 -o "$body" -w '%{http_code}' -H "Authorization: Bearer $token" "$url/v1/deploy/canary/$id?wait_s=20" 2>/dev/null || true)"
    ok="$(jq -r 'if .ok == null then "pending" else .ok end' "$body" 2>/dev/null)"
    if [[ "$code" = 200 && "$ok" = true ]]; then echo "smoke ok: $(jq -r .line "$body")"; return 0; fi
    if [[ "$code" = 200 && "$ok" = false ]]; then
      echo "smoke RED: $(jq -r .line "$body")"
      [[ -z "${ALERTS_TOPIC_ARN:-}" ]] || aws sns publish --topic-arn "$ALERTS_TOPIC_ARN" --subject "tower deploy canary RED" \
        --message "$(jq -r .line "$body") (build $key, canary $id)" >/dev/null 2>&1 || true
      return 1
    fi
    if (( SECONDS - began > over )); then
      echo "smoke RED: canary job $id has no verdict after $((SECONDS - began)) s: GET /v1/deploy/canary answered '${code:-no answer}'"; return 1
    fi
    # CANARY-HOLDS: canary.read holds every read it marks (long_poll), its listener open or not: asked again at once. An
    # unmarked answer held 2 s or more (a port older than CANARY-HOLDS whose listener opened, which a bisection's midpoint
    # may still serve until the deployed sha passes it, or a request that timed out) is asked again at once, as before.
    if jq -e 'has("long_poll")' "$body" >/dev/null 2>&1; then delay=$step; continue; fi
    if (( SECONDS - asked >= 2 )); then delay=$step; continue; fi
    # SMOKE-BACKOFF: a failed request answered at once (no answer, a 5xx: a port older than CANARY-HOLDS whose listener
    # could not open, a 429; or an unmarked state from a port with no listener at all, which the Lambda never is): asked
    # again after a pause that doubles from 1 s up to pause, cut so the next ask is no later than the red
    sleep "$(( delay <= over - (SECONDS - began) ? delay : over - (SECONDS - began) + 1 ))"
    (( delay += delay, delay < pause )) || delay=$pause
  done
}

# runner: SMOKE-WITHOUT-RUNNER. 0 when the canary should run (a runner takes its job, or nobody could tell), 1 when it is
# skipped; prints the reason of a skip.
runner() {
  local mode="${DEPLOY_SMOKE_CANARY:-auto}" cluster="${DEPLOY_SMOKE_RUNNER_CLUSTER:-tower}" service="${DEPLOY_SMOKE_RUNNER_SERVICE:-tower-runner}" desired
  case "$mode" in
    on) return 0 ;;
    off) echo "smoke: DEPLOY_SMOKE_CANARY=off: the canary job was skipped"; return 1 ;;
    auto) ;;
    *) echo "smoke: DEPLOY_SMOKE_CANARY='$mode' is not auto, on or off: the canary runs"; return 0 ;;
  esac
  if ! desired="$(aws ecs describe-services --cluster "$cluster" --services "$service" \
      --query "services[?status=='ACTIVE'] | [0].desiredCount" --output text 2>/dev/null)"; then
    # SMOKE-RUNNER-FROM-STACK: ECS did not answer. The deployer's role is not granted ecs:DescribeServices (the boundary
    # allows ecs:*, the role grants none of it: tower-infra-deploy:e70ed637, 14/11, ran the canary with the runner at 0 and
    # rolled back). The deployer reads its stacks, and every deploy passes the runner stack's DesiredCount from
    # infra/aws/parameters.json: that parameter is the runner's desired count as deployed. No answer from it either: run it.
    local stack="${DEPLOY_SMOKE_RUNNER_STACK:-tower-app-runner}" err
    err="$(mktemp)"
    if desired="$(aws cloudformation describe-stacks --stack-name "$stack" \
        --query "Stacks[0].Parameters[?ParameterKey=='DesiredCount'].ParameterValue | [0]" --output text 2>"$err")"; then
      rm -f "$err"
      if [[ "$desired" = 0 ]]; then
        echo "smoke: the runner stack ($stack) has DesiredCount 0: no runner takes a check, the canary job was skipped"; return 1
      fi
      return 0
    fi
    if grep -q 'does not exist' "$err"; then
      rm -f "$err"
      echo "smoke: the runner stack ($stack) does not exist: no runner takes a check, the canary job was skipped"; return 1
    fi
    rm -f "$err"
    return 0  # neither ECS nor CloudFormation answered: run it
  fi
  if [[ "$desired" =~ ^[0-9]+$ ]] && (( desired > 0 )); then return 0; fi
  if [[ "$desired" = 0 ]]; then
    echo "smoke: the runner ($service in $cluster) has a desired count of 0: no runner takes a check, the canary job was skipped"; return 1
  fi
  if [[ -z "$desired" || "$desired" = None ]]; then
    echo "smoke: the runner ($service in $cluster) is missing or inactive: no runner takes a check, the canary job was skipped"; return 1
  fi
  return 0  # an answer it does not know: run it
}

red=0
check "GET /v1/health" /v1/health "" 200 '"ok": *true' hold || red=1
if [[ -n "$token" ]]; then
  if check "registry read: GET /v1/deploy/status" /v1/deploy/status auth 200 '"source": *"registry"'; then :; else red=1; fi
  if runner; then canary || red=1; fi
else
  check "GET /v1/deploy/status (no token: the route answers a refusal)" /v1/deploy/status "" '401|403' '' || red=1
  echo "smoke: no smoke token (/tower/deploy/smoke-token): the authenticated registry read was skipped, and the canary job with it"
fi
exit "$red"
