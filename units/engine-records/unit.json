    "scripts/tests/judgment-rule.test.sh",
    "scripts/tests/decision-table.test.sh",
    "scripts/tests/incident.test.sh",
    "scripts/tests/rule-challenges.test.sh",
    "scripts/tests/test_decision_handwritten_repo.py",
    "scripts/tests/test_decision_next.py",
    "scripts/tests/test_decision_record.py",
    "scripts/tests/test_judgment_rule.py",
