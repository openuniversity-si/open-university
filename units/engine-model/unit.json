{
  "id": "engine-model",
  "purpose": "The engineering model (PADRAO-DEV): the metamodel as data (object types, link types, systems, inventory sources, conformance scale) and scripts/model, which reads the objects of every system, checks the model and measures the end-to-end chain, the requirement inventory and each system's conformance.",
  "cell": "engine",
  "owner": "engine-lane",
  "paths": [
    "config/architecture/**",
    "config/intent/**",
    "config/model/**",
    "config/requirements/**",
    "config/standard/**",
    "config/supply/**",
    "config/validation/**",
    "contracts/model/*.json",
    "scripts/lib/model.py",
    "scripts/lib/padrao_metrics.py",
    "scripts/lib/supply.py",
    "scripts/model",
    "scripts/padrao-metrics",
    "scripts/supply",
    "scripts/tests/model.test.sh",
    "scripts/tests/padrao-metrics.test.sh",
    "scripts/tests/supply.test.sh",
    "scripts/tests/test_model.py",
    "scripts/tests/test_padrao_metrics.py",
    "scripts/tests/test_supply.py"
  ],
  "requires": {
    "engine-config": "^1",
    "engine-gate-plan": "^1",
    "engine-premises": "^1",
    "engine-units": "^1",
    "engine-rules": "^1",
    "engine-gate-tests": "^1",
    "engine-config-check": "^1"
  },
  "realizes": [
    "ARC-model"
  ]
}
