{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/cloud/setup.sh",
            "timeout": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/bash-trim",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/cycle-stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "TodoWrite",
      "NotebookEdit",
      "Skill",
      "ToolSearch",
      "AskUserQuestion",
      "Monitor",
      "SendMessage",
      "ListAgents",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "SendUserFile",
      "PushNotification",
      "ReadNotifications",
      "Artifact",
      "ReportFindings",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "mcp__github",
      "mcp__claude-code-remote"
    ],
    "deny": [
      "Bash(scripts/ship-tail:*)",
      "Bash(./scripts/ship-tail:*)",
      "Bash(bash scripts/ship-tail:*)",
      "Bash(bash ./scripts/ship-tail:*)",
      "Bash(scripts/neon-migrate:*)",
      "Bash(./scripts/neon-migrate:*)",
      "Bash(bash scripts/neon-migrate:*)",
      "Bash(bash ./scripts/neon-migrate:*)",
      "Bash(scripts/ship-verify:*)",
      "Bash(./scripts/ship-verify:*)",
      "Bash(bash scripts/ship-verify:*)",
      "Bash(bash ./scripts/ship-verify:*)",
      "Bash(scripts/merge-phase:*)",
      "Bash(./scripts/merge-phase:*)",
      "Bash(bash scripts/merge-phase:*)",
      "Bash(bash ./scripts/merge-phase:*)",
      "Bash(scripts/preview-deploy:*)",
      "Bash(./scripts/preview-deploy:*)",
      "Bash(bash scripts/preview-deploy:*)",
      "Bash(bash ./scripts/preview-deploy:*)",
      "Bash(scripts/production-check:*)",
      "Bash(./scripts/production-check:*)",
      "Bash(bash scripts/production-check:*)",
      "Bash(bash ./scripts/production-check:*)",
      "Bash(scripts/neon-pr:*)",
      "Bash(./scripts/neon-pr:*)",
      "Bash(bash scripts/neon-pr:*)",
      "Bash(bash ./scripts/neon-pr:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * -f:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * --force-with-lease:*)",
      "Bash(git push * +*)",
      "Bash(git push +*)",
      "Write(.github/workflows/**)",
      "Edit(.github/workflows/**)",
      "Write(**/.github/workflows/**)",
      "Edit(**/.github/workflows/**)"
    ]
  }
}
