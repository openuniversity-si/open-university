  "pages": {
    "about": {
      "slug": "about",
      "kicker": "ABOUT",
      "title": "Open University",
      "metaTitle": "About",
      "description": "Open University is the free initiative of The Tower: full university courses in one ordered library. No ads, no paywall, free permanently.",
      "lead": "The lectures worth remembering.\nThe world's great universities, in one big, beautiful library.",
      "body": [
        "Universities publish extraordinary teaching, and it is scattered across channels, playlists and semesters, easy to lose and hard to follow in order. Open University gathers full courses from institutions such as MIT, Yale, Harvard, Stanford and Carnegie Mellon and arranges each one as it was taught: lecture by lecture, edition by edition, with your progress kept if you choose to sign in.",
        "It is made as a companion to formal study, not a replacement for it: a second explanation of a hard topic, another professor on the same subject, a course to follow beside the one you are enrolled in, or one you never had the chance to take. Every lecture stays on its original channel and is credited to its author and institution. There is no affiliation with, and no endorsement from, any of them.",
        "No short videos, no ads, no infinite scroll. A sober, focused room for serious study, where nothing asks for your attention beyond the lecture itself."
      ],
      "wink": "One library to rule them all.",
      "closing": "Open University is the free initiative of The Tower. Our commitment: it is free, permanently. No ads, no paywall, no charge to watch. That will not change.",
      "cta": {
        "label": "Enter",
        "href": "/"
      }
    },
    "privacy": {
      "slug": "privacy",
      "kicker": "LEGAL",
      "title": "Privacy",
      "description": "What Open University collects and why: your Google name and email, lecture progress, and one sign-in cookie. No tracking, and no sale of data.",
      "lead": "This page explains, in plain language, what Open University collects, why, and how you can have it deleted.",
      "sections": [
        {
          "h": "Who is responsible",
          "p": [
            "Open University is responsible for the data described here. For anything about your data, write to contact@openuniversity.si."
          ]
        },
        {
          "h": "What we collect",
          "p": [
            "You can browse Open University without an account. If you sign in with Google, we receive and store your name, your email address and the ID of your Google account.",
            "We ask Google only for basic identity (openid, email and profile). We do not store your Google profile picture, and we never get access to your contacts, calendar, Drive or any other Google data.",
            "While you watch with an account, we save for each lecture:"
          ],
          "ul": [
            "your playback position and the length of the lecture;",
            "whether and when you marked it complete."
          ],
          "after": [
            "This powers Resume, Continue Watching and your progress.",
            "Like any web server, our hosting provider receives technical data such as your IP address and browser type whenever a page loads. We use it only to deliver the site and keep it secure, and we do not add it to your account. Sign-in attempts are rate-limited with short-lived counters to prevent abuse."
          ]
        },
        {
          "h": "Cookies and storage",
          "p": [
            "Open University itself uses only strictly necessary cookies: a small session cookie, prefixed “open-university”, that keeps you signed in for up to 30 days and is removed when you sign out. Your browser’s session storage may briefly remember where to send you back after signing in.",
            "We set no advertising, analytics or tracking cookies of our own. The embedded YouTube player, however, may set YouTube cookies in your browser (see “YouTube videos” below)."
          ]
        },
        {
          "h": "YouTube videos",
          "p": [
            "Lectures play through YouTube’s embedded player, which may set YouTube cookies in your browser. When a video loads or plays, YouTube and Google may also collect data, such as your IP address and viewing activity, under their own policies. We do not control that and do not receive those cookies. See the Google Privacy Policy (https://policies.google.com/privacy) and the YouTube Terms of Service (https://www.youtube.com/t/terms)."
          ]
        },
        {
          "h": "Who else handles data",
          "p": [
            "We do not sell your data and do not share it for marketing. Open University shows no advertising and has committed never to. The only parties that process data for us are the services that run the site: Google (sign-in), Amazon Web Services (hosting and database) and Cloudflare (images)."
          ]
        },
        {
          "h": "How long we keep it",
          "p": [
            "Your account and your progress stay until you ask us to delete them. Sign-in sessions expire after 30 days."
          ]
        },
        {
          "h": "Your rights",
          "p": [
            "Under Brazil’s data protection law (LGPD) you can ask us to confirm, access, correct or delete your data, or to give you a copy.",
            "To delete your account and all your progress, email contact@openuniversity.si from the address you signed in with. We reply within 15 days."
          ]
        },
        {
          "h": "Children",
          "p": [
            "Open University is not directed at children, and we do not knowingly collect their data."
          ]
        },
        {
          "h": "Changes",
          "p": [
            "If this page changes in a meaningful way, we will update the date above."
          ]
        }
      ]
    },
    "terms": {
      "slug": "terms",
      "kicker": "LEGAL",
      "title": "Terms",
      "description": "The rules for using Open University: lectures belong to their authors and stream from YouTube; free to use, permanently; no warranty.",
      "lead": "These terms cover your use of Open University at openuniversity.si. By using the site, you agree to them.",
      "sections": [
        {
          "h": "What Open University is",
          "p": [
            "Open University is the free initiative of The Tower, the organization behind it. It organizes lecture courses into an easy-to-follow library, with optional sign-in to save your progress."
          ]
        },
        {
          "h": "Free, permanently",
          "p": [
            "Open University is free to use, permanently. We will not show ads, put lectures behind a paywall or charge anyone to watch. This is a commitment about cost and access; it is not a promise that every lecture will stay online (see No warranty)."
          ]
        },
        {
          "h": "Name and affiliation",
          "p": [
            "Open University is the name of an initiative, not of an educational institution. It does not grant degrees or academic credit. Lectures keep their authors and sources, are credited to them, and play through the original embedded player.",
            "Open University is not affiliated with, or endorsed by, The Open University (United Kingdom) or any other university or institution whose lectures appear here."
          ]
        },
        {
          "h": "The lectures belong to their authors",
          "p": [
            "Each lecture belongs to its author and rights holders. Every lecture is streamed from its original source on YouTube through YouTube’s embedded player. We do not host, copy or re-upload any video.",
            "Open University is not affiliated with, or endorsed by, the authors, YouTube or Google."
          ]
        },
        {
          "h": "YouTube",
          "p": [
            "Playback is subject to the YouTube Terms of Service (https://www.youtube.com/t/terms) and the Google Privacy Policy (https://policies.google.com/privacy). If an owner removes or restricts a video, it will stop working here."
          ]
        },
        {
          "h": "Your use",
          "p": [
            "You may use Open University for your own learning. Please do not resell or redistribute it, scrape it, overload it, probe it for vulnerabilities, or try to get around sign-in or other protections."
          ]
        },
        {
          "h": "Your account",
          "p": [
            "Signing in is optional and happens through Google. You are responsible for what happens under your account. You can ask us to delete it at any time (see Privacy)."
          ]
        },
        {
          "h": "Removal requests",
          "p": [
            "If you are an author or rights holder and want a lecture or reference removed, write to contact@openuniversity.si and we will act promptly."
          ]
        },
        {
          "h": "No warranty",
          "p": [
            "Open University is provided “as is”, with no promise that it will always be available or error-free, or that any lecture will stay online. Course descriptions are our own editorial summaries. To the extent the law allows, we are not liable for losses arising from using the site."
          ]
        },
        {
          "h": "Changes",
          "p": [
            "We may update these terms. The date above shows the latest version, and continuing to use the site means you accept the changes."
          ]
        },
        {
          "h": "Governing law",
          "p": [
            "These terms are governed by the laws of Brazil, and any dispute will be brought before the Brazilian courts, without prejudice to mandatory consumer-protection rules."
          ]
        }
      ]
    },
    "contact": {
      "slug": "contact",
      "kicker": "CONTACT",
      "title": "Contact",
      "description": "Write to Open University: questions, feedback, broken lectures, rights-holder requests, or deleting your account and data.",
      "lead": "Questions, feedback, or a request about your data? Write to us.",
      "cardLabel": "Email",
      "cta": "Email us",
      "sections": [
