{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The DNS of openuniversity.si on Route 53 (D-323 step 3), generated by scripts/dns-zone from the record list infra/aws/dns/openuniversity.si.json (never edited by hand). Zone off (the first deploy, before the Torre re-applies the bootstrap with route53 in the boundary) is a wait-condition handle alone; Zone on is the hosted zone, retained, its four name servers an output, and one record set per name and type of the list; an apex CNAME to CloudFront is an alias A and AAAA to SiteDistribution, absent while it is empty; a target named by an export is an alias A and AAAA to its Fn::ImportValue (the exporting stack comes first in order.json). Cost: US$ 0.50 a month for the zone plus US$ 0.40 per million queries (alias queries to CloudFront are free); the query volume is not known, so the bound is 10 million queries a month: at most US$ 4.50 a month.",
  "Parameters": {
    "Zone": {
      "Type": "String",
      "Default": "off",
      "AllowedValues": [
        "off",
        "on"
      ],
      "Description": "on creates the hosted zone and its records; off (until the boundary allows route53) creates nothing that bills"
    },
    "SiteDistribution": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9]+\\.cloudfront\\.net$",
      "Description": "the site's CloudFront domain the apex aliases (A and AAAA); empty: no apex record yet"
    }
  },
  "Conditions": {
    "ZoneOff": {
      "Fn::Equals": [
        {
          "Ref": "Zone"
        },
        "off"
      ]
    },
    "ZoneOn": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "Zone"
            },
            "off"
          ]
        }
      ]
    },
    "SiteKnown": {
      "Fn::And": [
        {
          "Condition": "ZoneOn"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "SiteDistribution"
                },
                ""
              ]
            }
          ]
        }
      ]
    }
  },
  "Resources": {
    "Pending": {
      "Type": "AWS::CloudFormation::WaitConditionHandle",
      "Condition": "ZoneOff",
      "Properties": {}
    },
    "HostedZone": {
      "Type": "AWS::Route53::HostedZone",
      "Condition": "ZoneOn",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "openuniversity.si.",
        "HostedZoneConfig": {
          "Comment": "openuniversity.si (D-323 step 3), from infra/aws/dns by scripts/dns-zone"
        }
      }
    },
    "Record0caf1ede61e0b4e7b1479112fab2d9e5MediaCname": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "_0caf1ede61e0b4e7b1479112fab2d9e5.media.openuniversity.si.",
        "Type": "CNAME",
        "TTL": "300",
        "ResourceRecords": [
          "_2a2acb8ca9f7ebcd81013c22c8d243a0.wzccmgtwzk.acm-validations.aws."
        ]
      }
    },
    "Record35fea2b741d03cbfbbf7de1c69feed6bWwwCname": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "_35fea2b741d03cbfbbf7de1c69feed6b.www.openuniversity.si.",
        "Type": "CNAME",
        "TTL": "300",
        "ResourceRecords": [
          "_7b07c4af832e201447a4b39423c4f4ab.wzccmgtwzk.acm-validations.aws."
        ]
      }
    },
    "Record39debf49a94bd92f1530716d49f40aedCname": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "_39debf49a94bd92f1530716d49f40aed.openuniversity.si.",
        "Type": "CNAME",
        "TTL": "300",
        "ResourceRecords": [
          "_a6da2254b6f7095da747cb27f18a46b8.wzccmgtwzk.acm-validations.aws."
        ]
      }
    },
    "RecordCf20241DomainkeyTxt": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "cf2024-1._domainkey.openuniversity.si.",
        "Type": "TXT",
        "TTL": "300",
        "ResourceRecords": [
          "\"v=DKIM1; h=sha256; k=rsa; p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAiweykoi+o48IOGuP7GR3X0MOExCUDY/BCRHoWBnh3rChl7WhdyCxW3jgq1daEjPPqoi7sJvdg5hEQVsgVRQP4DcnQDVjGMbASQtrY4WmB1VebF+RPJB2ECPsEDTpeiI5ZyUAwJaVX7r6bznU67g7LvFq35yIo4sdlmtZGV+i0H4cpYH9+3JJ78k\" \"m4KXwaf9xUJCWF6nxeD+qG6Fyruw1Qlbds2r85U9dkNDVAS3gioCvELryh1TxKGiVTkg4wqHTyHfWsp7KD3WQHYJn0RyfJJu6YEmL77zonn7p2SRMvTMP3ZEXibnC9gz3nnhR6wcYL8Q7zXypKTMD58bTixDSJwIDAQAB\""
        ]
      }
    },
    "RecordMediaA": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "media.openuniversity.si.",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::ImportValue": "tower-media-distribution-domain"
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "RecordMediaAaaa": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "media.openuniversity.si.",
        "Type": "AAAA",
        "AliasTarget": {
          "DNSName": {
            "Fn::ImportValue": "tower-media-distribution-domain"
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "RecordApexA": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "SiteKnown",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "openuniversity.si.",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Ref": "SiteDistribution"
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "RecordApexAaaa": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "SiteKnown",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "openuniversity.si.",
        "Type": "AAAA",
        "AliasTarget": {
          "DNSName": {
            "Ref": "SiteDistribution"
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "RecordApexMx": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "openuniversity.si.",
        "Type": "MX",
        "TTL": "300",
        "ResourceRecords": [
          "22 route1.mx.cloudflare.net.",
          "74 route3.mx.cloudflare.net.",
          "91 route2.mx.cloudflare.net."
        ]
      }
    },
    "RecordApexTxt": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "openuniversity.si.",
        "Type": "TXT",
        "TTL": "300",
        "ResourceRecords": [
          "\"v=spf1 include:_spf.mx.cloudflare.net ~all\""
        ]
      }
    },
    "RecordWwwCname": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "ZoneOn",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZone"
        },
        "Name": "www.openuniversity.si.",
        "Type": "CNAME",
        "TTL": "300",
        "ResourceRecords": [
          "dns1rg162g0y7.cloudfront.net."
        ]
      }
    }
  },
  "Outputs": {
    "ZoneId": {
      "Condition": "ZoneOn",
      "Value": {
        "Ref": "HostedZone"
      }
    },
    "NameServers": {
      "Condition": "ZoneOn",
      "Description": "the four name servers the registrar gets",
      "Value": {
        "Fn::Join": [
          ",",
          {
            "Fn::GetAtt": [
              "HostedZone",
              "NameServers"
            ]
          }
        ]
      }
    }
  }
}
