{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The infrastructure's service (P3 F1): one ECS Fargate task on ARM (0.25 vCPU, 0.5 GB) with the image the deployer built, in the public subnets with a public IP and the tasks' group (no inbound, no NAT). Its init container makes the IAM login of the database with the owner's password, which only it receives; the service container connects by IAM token, applies the migrations and runs DBOS. ECS replaces a task that stops or fails its health check. About US$ 7 a month and US$ 3.65 for the public IP. IMAGE-PREWARM-B2: tower-service-standby is the same service without the init container; the live service runs it, and a tower-runner, for an authoring head's code bundle, within deploy.prewarm_max_tasks.",
  "Parameters": {
    "Image": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/tower/deploy/image/service",
      "Description": "The image reference the deployer records after it builds infra/service (INFRA-SVC 1a); read again at every deploy"
    },
    "LiveCode": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^([0-9a-f]{64})?$",
      "Description": "IMAGE-PREWARM-C: the code bundle the tasks boot (artifacts/lambda/tower-code/<sha256>.zip) and their TOWER_IMAGE_DIGEST, passed by deploy.sh when the deployed head's code is the bundle a landing swapped to; empty: the image's own code, its reference the digest"
    },
    "LiveSeen": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^(unknown|[0-9a-f]{64}@[0-9a-f]{7,64})?$",
      "Description": "SLOW-PATH-NO-ROLLOUT-WAIT: deploy.live_code as deploy.sh read it when it deployed this task definition (TOWER_CODE_SEEN). A task boots the live code instead of this definition's only when the datum is another value, i.e. a landing swapped after this deploy; unknown: the deployer could not read it, the task never follows the datum. Not part of the stack's hash"
    },
    "Cpu": {
      "Type": "String",
      "Default": "512",
      "Description": "CPU units of the task: 512 since 13/11 (the landing's merge, the Origin CLI's start on 256, p99 7.15 s; deploy.sh passes infra/aws/parameters.json's service.Cpu), 1024 at 1 PR/s"
    },
    "Memory": {
      "Type": "String",
      "Default": "1024",
      "Description": "MiB of the task: 1024 since 13/11 (the 512 MiB task was killed out of memory at 17:52 UTC, its whole-task memory 370 to 393 MB at its peaks; deploy.sh passes infra/aws/parameters.json's service.Memory), 2048 at 1 PR/s"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 1,
      "MinValue": 0,
      "Description": "Tasks of the service: one at 1 PR/min, two in two zones at 1 PR/s"
    }
  },
  "Conditions": {
    "HasLiveCode": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "LiveCode"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/tower/service",
        "RetentionInDays": 14
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "tower",
        "CapacityProviders": [
          "FARGATE",
          "FARGATE_SPOT"
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tower-app-service-exec",
        "Description": "ECS pulls the service image, writes its logs and reads the owner's password for the init container",
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/tower-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "service-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "LogInToTheImageRegistry",
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Sid": "PullTheServiceImage",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/tower-service"
                  }
                },
                {
                  "Sid": "WriteTheLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Logs.Arn}"
                  }
                },
                {
                  "Sid": "ReadTheOwnerPasswordForTheInitContainer",
                  "Effect": "Allow",
                  "Action": "ssm:GetParameters",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/db/master-password"
                  }
                },
                {
                  "Sid": "DecryptItThroughParameterStore",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tower-app-service",
        "Description": "The service connects to tower-data as the IAM database user tower_service, reads the forge key when a landing runs and publishes the log's subscriptions to the installation's topics",
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/tower-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "service-database",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ConnectAsTheServiceLogin",
                  "Effect": "Allow",
                  "Action": "rds-db:connect",
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser:${Instance}/tower_service",
                      {
                        "Instance": {
                          "Fn::ImportValue": "tower-data-resource-id"
                        }
                      }
                    ]
                  }
                },
                {
                  "Sid": "ReadTheForgeAndSessionKeysWhenUsed",
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/origin/forge-key"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/sessions/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/origin/factory-app-signing-key"
                    }
                  ]
                },
                {
                  "Sid": "WriteBackRenewedCliSessionCredentials",
                  "Effect": "Allow",
                  "Action": "ssm:PutParameter",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/sessions/claude-code"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/sessions/codex"
                    }
                  ]
                },
                {
                  "Sid": "PublishTheForgeKeysToTheWebhookIngress",
                  "Effect": "Allow",
                  "Action": "ssm:PutParameter",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/port/forge-keys"
                  }
                },
                {
                  "Sid": "DecryptItThroughParameterStore",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                },
                {
                  "Sid": "PublishTheLogToTheInstallationsTopics",
                  "Effect": "Allow",
                  "Action": "sns:Publish",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:tower-*"
                  }
                },
                {
                  "Sid": "InferWithClaudeInBedrock",
                  "Effect": "Allow",
                  "Action": "bedrock-mantle:CreateInference",
                  "Resource": "*"
                },
                {
                  "Sid": "ConverseWithBedrocksModels",
                  "Effect": "Allow",
                  "Action": "bedrock:InvokeModel",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:*::foundation-model/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:*:${AWS::AccountId}:inference-profile/*"
                    }
                  ]
                }
              ]
            }
          },
          {
            "PolicyName": "autodeploy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "RingTheDeployDoorbell",
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-deploy-doorbell"
                  }
                },
                {
                  "Sid": "ReadWhatWasDeployed",
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/deploy/last-sha"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/deploy/last-build"
                    }
                  ]
                },
                {
                  "Sid": "SwapThePortAliases",
                  "Effect": "Allow",
                  "Action": [
                    "lambda:UpdateFunctionCode",
                    "lambda:PublishVersion",
                    "lambda:UpdateAlias",
                    "lambda:GetAlias",
                    "lambda:GetFunctionConfiguration",
                    "lambda:InvokeFunction"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-api"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-api:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-ack-ingress"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-ack-ingress:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-webhook-consumer"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-webhook-consumer:*"
                    }
                  ]
                },
                {
                  "Sid": "ReadTheLambdaArtifacts",
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::tower-outputs-${AWS::AccountId}-${AWS::Region}/artifacts/lambda/*"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "prewarm",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "RunTheStandbysOfAnAuthoringHead",
                  "Effect": "Allow",
                  "Action": "ecs:RunTask",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:task-definition/tower-runner:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:task-definition/tower-service-standby:*"
                    }
                  ],
                  "Condition": {
                    "ArnEquals": {
                      "ecs:cluster": {
                        "Fn::GetAtt": [
                          "Cluster",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Sid": "StopAndWatchTheTasksOfTheCluster",
                  "Effect": "Allow",
                  "Action": [
                    "ecs:StopTask",
                    "ecs:DescribeTasks"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:task/${Cluster}/*"
                  }
                },
                {
                  "Sid": "TagTheStandbysAtTheirLaunch",
                  "Effect": "Allow",
                  "Action": "ecs:TagResource",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:task/${Cluster}/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "ecs:CreateAction": "RunTask"
                    }
                  }
                },
                {
                  "Sid": "PassTheStandbysRolesOnlyToEcsTasks",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/tower-app-runner"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/tower-app-runner-exec"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/tower-app-service"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/tower-app-service-exec"
                    }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "ecs-tasks.amazonaws.com"
                    }
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "prune",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ListThePortVersionsAndAliases",
                  "Effect": "Allow",
                  "Action": [
                    "lambda:ListVersionsByFunction",
                    "lambda:ListAliases"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-api"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-webhook-consumer"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-ack-ingress"
                    }
                  ]
                },
                {
                  "Sid": "DeleteOnlyQualifiedPortVersions",
                  "Effect": "Allow",
                  "Action": "lambda:DeleteFunction",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-api:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-webhook-consumer:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:tower-port-ack-ingress:*"
                    }
                  ]
                },
                {
                  "Sid": "ListTheLambdaArtifacts",
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::tower-outputs-${AWS::AccountId}-${AWS::Region}"
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": "artifacts/lambda/*"
                    }
                  }
                },
                {
                  "Sid": "DeleteOldLambdaArtifacts",
                  "Effect": "Allow",
                  "Action": "s3:DeleteObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::tower-outputs-${AWS::AccountId}-${AWS::Region}/artifacts/lambda/*"
                  }
                },
                {
                  "Sid": "ReadTheServicesOfTheCluster",
                  "Effect": "Allow",
                  "Action": "ecs:DescribeServices",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:service/${Cluster}/*"
                  }
                },
                {
                  "Sid": "ReadTheirTaskDefinitions",
                  "Effect": "Allow",
                  "Action": "ecs:DescribeTaskDefinition",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "tower-service",
        "Cpu": {
          "Ref": "Cpu"
        },
        "Memory": {
          "Ref": "Memory"
        },
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "init",
            "Image": {
              "Ref": "Image"
            },
            "Essential": false,
            "Command": [
              "init"
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TOWER_DB_HOST",
                "Value": {
                  "Fn::ImportValue": "tower-data-endpoint"
                }
              },
              {
                "Name": "TOWER_DB_PORT",
                "Value": {
                  "Fn::ImportValue": "tower-data-port"
                }
              },
              {
                "Name": "TOWER_DB_NAME",
                "Value": {
                  "Fn::ImportValue": "tower-data-name"
                }
              },
              {
                "Name": "TOWER_DB_OWNER",
                "Value": "tower_owner"
              }
            ],
            "Secrets": [
              {
                "Name": "TOWER_DB_OWNER_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/db/master-password"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "init"
              }
            }
          },
          {
            "Name": "service",
            "Image": {
              "Ref": "Image"
            },
            "Essential": true,
            "Command": [
              "serve"
            ],
            "DependsOn": [
              {
                "ContainerName": "init",
                "Condition": "SUCCESS"
              }
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TOWER_DB_HOST",
                "Value": {
                  "Fn::ImportValue": "tower-data-endpoint"
                }
              },
              {
                "Name": "TOWER_DB_PORT",
                "Value": {
                  "Fn::ImportValue": "tower-data-port"
                }
              },
              {
                "Name": "TOWER_DB_NAME",
                "Value": {
                  "Fn::ImportValue": "tower-data-name"
                }
              },
              {
                "Name": "TOWER_IMAGE",
                "Value": {
                  "Ref": "Image"
                }
              },
              {
                "Name": "TOWER_IMAGE_DIGEST",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Ref": "LiveCode"
                    },
                    {
                      "Ref": "Image"
                    }
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_KEY",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Fn::Sub": "artifacts/lambda/tower-code/${LiveCode}.zip"
                    },
                    ""
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_SHA256",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Ref": "LiveCode"
                    },
                    ""
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_SEEN",
                "Value": {
                  "Ref": "LiveSeen"
                }
              },
              {
                "Name": "TOWER_FORGE_KEY_PARAMETER",
                "Value": "/tower/origin/forge-key"
              },
              {
                "Name": "TOWER_API_MODELS",
                "Value": "{\"bedrock\":[\"anthropic.claude-haiku-5-5\",\"global.anthropic.claude-haiku-5-5\",\"us.anthropic.claude-haiku-5-5\"],\"bedrock-converse\":[\"amazon.nova-micro-v1:0\",\"us.amazon.nova-micro-v1:0\",\"us.anthropic.claude-haiku-4-5-20251001-v1:0\"]}"
              },
              {
                "Name": "TOWER_FORGE_KEYS_PARAMETER",
                "Value": "/tower/port/forge-keys"
              },
              {
                "Name": "TOWER_DOORBELL_FUNCTION",
                "Value": "tower-deploy-doorbell"
              },
              {
                "Name": "TOWER_ARTIFACT_BUCKET",
                "Value": {
                  "Fn::Sub": "tower-outputs-${AWS::AccountId}-${AWS::Region}"
                }
              },
              {
                "Name": "TOWER_STANDBY_CLUSTER",
                "Value": {
                  "Ref": "Cluster"
                }
              },
              {
                "Name": "TOWER_STANDBY_SUBNETS",
                "Value": {
                  "Fn::ImportValue": "tower-network-public-subnets"
                }
              },
              {
                "Name": "TOWER_STANDBY_SECURITY_GROUPS",
                "Value": {
                  "Fn::ImportValue": "tower-network-tasks-sg"
                }
              },
              {
                "Name": "TOWER_ORIGIN_APP_KEY_PARAMETER",
                "Value": "/tower/origin/factory-app-signing-key"
              },
              {
                "Name": "TOWER_ORIGIN_APP_ID",
                "Value": "app_01m6xw70rffaba293r8x5r40sz"
              },
              {
                "Name": "TOWER_ORIGIN_APP_INSTALLATION",
                "Value": "i_01m6xwbc7rfp599htkbwamf817"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "f=\"${TOWER_HEALTH_FILE:-/tmp/tower-infra.healthy}\"; [ -f \"$f\" ] && [ $(( $(date +%s) - $(stat -c %Y \"$f\") )) -lt \"${TOWER_HEALTH_FRESH_S:-120}\" ]"
              ],
              "Interval": 10,
              "Timeout": 5,
              "Retries": 9,
              "StartPeriod": 120
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "service"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "StandbyTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "tower-service-standby",
        "Cpu": {
          "Ref": "Cpu"
        },
        "Memory": {
          "Ref": "Memory"
        },
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "service",
            "Image": {
              "Ref": "Image"
            },
            "Essential": true,
            "StopTimeout": 120,
            "Command": [
              "serve"
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TOWER_DB_HOST",
                "Value": {
                  "Fn::ImportValue": "tower-data-endpoint"
                }
              },
              {
                "Name": "TOWER_DB_PORT",
                "Value": {
                  "Fn::ImportValue": "tower-data-port"
                }
              },
              {
                "Name": "TOWER_DB_NAME",
                "Value": {
                  "Fn::ImportValue": "tower-data-name"
                }
              },
              {
                "Name": "TOWER_IMAGE",
                "Value": {
                  "Ref": "Image"
                }
              },
              {
                "Name": "TOWER_IMAGE_DIGEST",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Ref": "LiveCode"
                    },
                    {
                      "Ref": "Image"
                    }
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_KEY",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Fn::Sub": "artifacts/lambda/tower-code/${LiveCode}.zip"
                    },
                    ""
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_SHA256",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Ref": "LiveCode"
                    },
                    ""
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_SEEN",
                "Value": {
                  "Ref": "LiveSeen"
                }
              },
              {
                "Name": "TOWER_FORGE_KEY_PARAMETER",
                "Value": "/tower/origin/forge-key"
              },
              {
                "Name": "TOWER_API_MODELS",
                "Value": "{\"bedrock\":[\"anthropic.claude-haiku-5-5\",\"global.anthropic.claude-haiku-5-5\",\"us.anthropic.claude-haiku-5-5\"],\"bedrock-converse\":[\"amazon.nova-micro-v1:0\",\"us.amazon.nova-micro-v1:0\",\"us.anthropic.claude-haiku-4-5-20251001-v1:0\"]}"
              },
              {
                "Name": "TOWER_FORGE_KEYS_PARAMETER",
                "Value": "/tower/port/forge-keys"
              },
              {
                "Name": "TOWER_DOORBELL_FUNCTION",
                "Value": "tower-deploy-doorbell"
              },
              {
                "Name": "TOWER_ARTIFACT_BUCKET",
                "Value": {
                  "Fn::Sub": "tower-outputs-${AWS::AccountId}-${AWS::Region}"
                }
              },
              {
                "Name": "TOWER_STANDBY_CLUSTER",
                "Value": {
                  "Ref": "Cluster"
                }
              },
              {
                "Name": "TOWER_STANDBY_SUBNETS",
                "Value": {
                  "Fn::ImportValue": "tower-network-public-subnets"
                }
              },
              {
                "Name": "TOWER_STANDBY_SECURITY_GROUPS",
                "Value": {
                  "Fn::ImportValue": "tower-network-tasks-sg"
                }
              },
              {
                "Name": "TOWER_ORIGIN_APP_KEY_PARAMETER",
                "Value": "/tower/origin/factory-app-signing-key"
              },
              {
                "Name": "TOWER_ORIGIN_APP_ID",
                "Value": "app_01m6xw70rffaba293r8x5r40sz"
              },
              {
                "Name": "TOWER_ORIGIN_APP_INSTALLATION",
                "Value": "i_01m6xwbc7rfp599htkbwamf817"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "f=\"${TOWER_HEALTH_FILE:-/tmp/tower-infra.healthy}\"; [ -f \"$f\" ] && [ $(( $(date +%s) - $(stat -c %Y \"$f\") )) -lt \"${TOWER_HEALTH_FRESH_S:-120}\" ]"
              ],
              "Interval": 10,
              "Timeout": 5,
              "Retries": 9,
              "StartPeriod": 120
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "standby"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "tower-service",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Fn::Split": [
                ",",
                {
                  "Fn::ImportValue": "tower-network-public-subnets"
                }
              ]
            },
            "SecurityGroups": [
              {
                "Fn::ImportValue": "tower-network-tasks-sg"
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "PropagateTags": "SERVICE",
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    }
  },
  "Outputs": {
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      },
      "Export": {
        "Name": "tower-service-cluster"
      }
    },
    "TaskRole": {
      "Value": {
        "Fn::GetAtt": [
          "TaskRole",
          "Arn"
        ]
      },
      "Export": {
        "Name": "tower-service-task-role"
      }
    }
  }
}
