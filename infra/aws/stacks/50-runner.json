{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The container executor (P4 F1): one warm runner on Fargate Spot ARM (2 vCPU, 4 GB) with the service's image, in the public subnets with a public IP and the tasks' group (no inbound, no NAT), and the bucket that keeps the runs' logs. The runner takes the runs the dispatcher hands over to container executors, connects as the IAM database user tower_runner (its own login: it owns nothing and may do only what a runner does), reads the forge's key and its signing key when it uses them and writes only under runs/ in the bucket. A Spot interruption ends its run as lost, and ECS starts another task. About US$ 18 a month on Spot and US$ 3.65 for the public IP.",
  "Parameters": {
    "Image": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/tower/deploy/image/service",
      "Description": "The service's image (the runner is its run-container command), as the deployer recorded it; read again at every deploy"
    },
    "LiveCode": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^([0-9a-f]{64})?$",
      "Description": "IMAGE-PREWARM-C: the code bundle the tasks boot (artifacts/lambda/tower-code/<sha256>.zip) and their TOWER_IMAGE_DIGEST, passed by deploy.sh when the deployed head's code is the bundle a landing swapped to; empty: the image's own code, its reference the digest"
    },
    "LiveSeen": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^(unknown|[0-9a-f]{64}@[0-9a-f]{7,64})?$",
      "Description": "SLOW-PATH-NO-ROLLOUT-WAIT: deploy.live_code as deploy.sh read it when it deployed this task definition (TOWER_CODE_SEEN). A task boots the live code instead of this definition's only when the datum is another value, i.e. a landing swapped after this deploy; unknown: the deployer could not read it, the task never follows the datum. Not part of the stack's hash"
    },
    "Cpu": {
      "Type": "String",
      "Default": "2048",
      "Description": "CPU units of the warm runner: 2048 (2 vCPU) at 1 PR/min"
    },
    "Memory": {
      "Type": "String",
      "Default": "8192",
      "Description": "MiB of the warm runner: 8192, 2 GB for each of its four slots (AWS2; 4096 held two)"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "Description": "Warm runners (the capacity registered through the port gives one slot to each). 0 since the gate left AWS (the migration to GitHub, 14/11): infra/aws/parameters.json passes it on every deploy, so an apply of this stack never starts a runner again"
    },
    "LogDays": {
      "Type": "Number",
      "Default": 30,
      "MinValue": 1,
      "Description": "Days a run's log stays in the bucket"
    }
  },
  "Conditions": {
    "HasLiveCode": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "LiveCode"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Outputs": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "tower-outputs-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "runs-expire",
              "Status": "Enabled",
              "Prefix": "runs/",
              "ExpirationInDays": {
                "Ref": "LogDays"
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "OutputsOnlyOverTls": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Outputs"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyOverTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "${Outputs.Arn}"
                },
                {
                  "Fn::Sub": "${Outputs.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/tower/runner",
        "RetentionInDays": 14
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tower-app-runner-exec",
        "Description": "ECS pulls the service's image for the runner and writes its logs",
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/tower-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "runner-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "LogInToTheImageRegistry",
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Sid": "PullTheServiceImage",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/tower-service"
                  }
                },
                {
                  "Sid": "WriteTheLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Logs.Arn}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tower-app-runner",
        "Description": "The runner connects to tower-data as the IAM database user tower_runner, reads the forge's key and its signing key when it uses them, and keeps the runs' logs",
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/tower-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "runner",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ConnectAsTheRunnerLogin",
                  "Effect": "Allow",
                  "Action": "rds-db:connect",
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser:${Instance}/tower_runner",
                      {
                        "Instance": {
                          "Fn::ImportValue": "tower-data-resource-id"
                        }
                      }
                    ]
                  }
                },
                {
                  "Sid": "ReadTheForgeKeyAndTheSigningKeyWhenUsed",
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/origin/forge-key"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/tower/runner/signing-key"
                    }
                  ]
                },
                {
                  "Sid": "DecryptThemThroughParameterStore",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                },
                {
                  "Sid": "KeepTheRunsLogs",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${Outputs.Arn}/runs/*"
                  }
                },
                {
                  "Sid": "KeepTheLambdaArtifacts",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Outputs.Arn}/artifacts/lambda/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "tower-runner",
        "Cpu": {
          "Ref": "Cpu"
        },
        "Memory": {
          "Ref": "Memory"
        },
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "runner",
            "Image": {
              "Ref": "Image"
            },
            "Essential": true,
            "Command": [
              "run-container"
            ],
            "User": "0",
            "StopTimeout": 120,
            "LinuxParameters": {
              "InitProcessEnabled": true
            },
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TOWER_DB_HOST",
                "Value": {
                  "Fn::ImportValue": "tower-data-endpoint"
                }
              },
              {
                "Name": "TOWER_DB_PORT",
                "Value": {
                  "Fn::ImportValue": "tower-data-port"
                }
              },
              {
                "Name": "TOWER_DB_NAME",
                "Value": {
                  "Fn::ImportValue": "tower-data-name"
                }
              },
              {
                "Name": "TOWER_DB_USER",
                "Value": "tower_runner"
              },
              {
                "Name": "TOWER_IMAGE",
                "Value": {
                  "Ref": "Image"
                }
              },
              {
                "Name": "TOWER_IMAGE_DIGEST",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Ref": "LiveCode"
                    },
                    {
                      "Ref": "Image"
                    }
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_KEY",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Fn::Sub": "artifacts/lambda/tower-code/${LiveCode}.zip"
                    },
                    ""
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_SHA256",
                "Value": {
                  "Fn::If": [
                    "HasLiveCode",
                    {
                      "Ref": "LiveCode"
                    },
                    ""
                  ]
                }
              },
              {
                "Name": "TOWER_CODE_SEEN",
                "Value": {
                  "Ref": "LiveSeen"
                }
              },
              {
                "Name": "TOWER_FORGE_KEY_PARAMETER",
                "Value": "/tower/origin/forge-key"
              },
              {
                "Name": "TOWER_SIGNING_KEY_PARAMETER",
                "Value": "/tower/runner/signing-key"
              },
              {
                "Name": "TOWER_OUTPUTS_BUCKET",
                "Value": {
                  "Ref": "Outputs"
                }
              },
              {
                "Name": "TOWER_WORKDIR",
                "Value": "/work"
              },
              {
                "Name": "TOWER_RUNNER_SLOTS",
                "Value": "4"
              },
              {
                "Name": "TOWER_CHECK_USER",
                "Value": "tower-check"
              },
              {
                "Name": "TOWER_PREWARM_REPO",
                "Value": "openuniversity-si/open-university"
              },
              {
                "Name": "TOWER_PREWARM_TIMEOUT_S",
                "Value": "300"
              },
              {
                "Name": "TOWER_ARTIFACT_BUCKET",
                "Value": {
                  "Ref": "Outputs"
                }
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "f=\"${TOWER_HEALTH_FILE:-/tmp/tower-infra.healthy}\"; [ -f \"$f\" ] && [ $(( $(date +%s) - $(stat -c %Y \"$f\") )) -lt \"${TOWER_HEALTH_FRESH_S:-120}\" ]"
              ],
              "Interval": 10,
              "Timeout": 5,
              "Retries": 10,
              "StartPeriod": 300
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "runner"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "tower-runner",
        "Cluster": {
          "Fn::ImportValue": "tower-service-cluster"
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE_SPOT",
            "Weight": 1
          }
        ],
        "PlatformVersion": "LATEST",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Fn::Split": [
                ",",
                {
                  "Fn::ImportValue": "tower-network-public-subnets"
                }
              ]
            },
            "SecurityGroups": [
              {
                "Fn::ImportValue": "tower-network-tasks-sg"
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "PropagateTags": "SERVICE",
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    }
  },
  "Outputs": {
    "OutputsBucket": {
      "Value": {
        "Ref": "Outputs"
      },
      "Export": {
        "Name": "tower-runner-outputs-bucket"
      }
    },
    "TaskRole": {
      "Value": {
        "Fn::GetAtt": [
          "TaskRole",
          "Arn"
        ]
      },
      "Export": {
        "Name": "tower-runner-task-role"
      }
    }
  }
}
