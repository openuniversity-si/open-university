{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "E-mail of the domain on SES receiving (D-323, the Cloudflare exit; it replaces Cloudflare Email Routing). Mail off: a wait-condition handle alone. Mail on: the SES domain identity with Easy DKIM (its three tokens exported for the dns stack), the receipt rule set tower-mail (made active by the Torre: CloudFormation cannot) with one rule for every recipient of the domain that stores the raw message in a private SSE-S3 bucket deleted after 30 days; with MapParameter set, the rule also invokes a forwarder Lambda that reads the recipient map from that SSM parameter, rewrites From to the domain sender under SenderName (Reply-To the original) and sends through SES; empty, nothing is sent. Cost, bound 10,000 messages a month of one 256 KB chunk: SES receiving US$ 1.00 plus US$ 0.90 for chunks, sending US$ 1.00 plus US$ 0.12 a GB, S3 under US$ 0.10, Lambda in the free tier: at most US$ 3.20 a month.",
  "Parameters": {
    "Mail": {
      "Type": "String",
      "Default": "off",
      "AllowedValues": [
        "off",
        "on"
      ],
      "Description": "on creates the identity, the bucket and the rule set; off (until the boundary allows ses) creates nothing that bills"
    },
    "MapParameter": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^/[A-Za-z0-9_.\\-/]{1,1000}$",
      "Description": "the SSM parameter (String or SecureString, written by the Torre) that holds the map recipient -> destination(s) as JSON; empty: no forwarder, the rule only stores"
    },
    "Domain": {
      "Type": "String",
      "Default": "openuniversity.si",
      "AllowedPattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "Description": "the domain whose mail the rule receives and whose identity signs what is forwarded"
    },
    "SenderLocalPart": {
      "Type": "String",
      "Default": "forward",
      "AllowedPattern": "^[a-z0-9]([a-z0-9.-]{0,62}[a-z0-9])?$",
      "Description": "the local part of the From the forwarder writes (at Domain, verified with it)"
    },
    "SenderName": {
      "Type": "String",
      "Default": "Open University",
      "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9 .&'-]{0,62}$",
      "Description": "the display name of the From the forwarder writes (the Torre, 18/11: \"Open University\"); the original sender stays in Reply-To"
    },
    "TestDomain": {
      "Type": "String",
      "Default": "",
      "Description": "A subdomain the rules also accept, only for an end-to-end test of SES receiving while the domain MX stays elsewhere (its own MX points at SES); empty outside a test.",
      "AllowedPattern": "^$|^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
    }
  },
  "Conditions": {
    "MailOff": {
      "Fn::Equals": [
        {
          "Ref": "Mail"
        },
        "off"
      ]
    },
    "MailOn": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "Mail"
            },
            "off"
          ]
        }
      ]
    },
    "Forwards": {
      "Fn::And": [
        {
          "Condition": "MailOn"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "MapParameter"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "StoresOnly": {
      "Fn::And": [
        {
          "Condition": "MailOn"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "MapParameter"
            },
            ""
          ]
        }
      ]
    },
    "HasTestDomain": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "TestDomain"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Pending": {
      "Type": "AWS::CloudFormation::WaitConditionHandle",
      "Condition": "MailOff",
      "Properties": {}
    },
    "Identity": {
      "Type": "AWS::SES::EmailIdentity",
      "Condition": "MailOn",
      "Properties": {
        "EmailIdentity": {
          "Ref": "Domain"
        },
        "DkimAttributes": {
          "SigningEnabled": true
        },
        "DkimSigningAttributes": {
          "NextSigningKeyLength": "RSA_2048_BIT"
        },
        "FeedbackAttributes": {
          "EmailForwardingEnabled": true
        }
      }
    },
    "Inbox": {
      "Type": "AWS::S3::Bucket",
      "Condition": "MailOn",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "mail-expire",
              "Status": "Enabled",
              "ExpirationInDays": 30,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "InboxPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Condition": "MailOn",
      "Properties": {
        "Bucket": {
          "Ref": "Inbox"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyOverTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "${Inbox.Arn}"
                },
                {
                  "Fn::Sub": "${Inbox.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "WrittenBySesReceivingOfThisRuleSet",
              "Effect": "Allow",
              "Principal": {
                "Service": "ses.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${Inbox.Arn}/inbox/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:receipt-rule-set/tower-mail:receipt-rule/*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "RuleSet": {
      "Type": "AWS::SES::ReceiptRuleSet",
      "Condition": "MailOn",
      "Properties": {
        "RuleSetName": "tower-mail"
      }
    },
    "StoreRule": {
      "Type": "AWS::SES::ReceiptRule",
      "Condition": "StoresOnly",
      "DependsOn": [
        "InboxPolicy"
      ],
      "Properties": {
        "RuleSetName": {
          "Ref": "RuleSet"
        },
        "Rule": {
          "Name": "tower-mail-store",
          "Enabled": true,
          "ScanEnabled": true,
          "TlsPolicy": "Optional",
          "Recipients": {
            "Fn::If": [
              "HasTestDomain",
              [
                {
                  "Ref": "Domain"
                },
                {
                  "Ref": "TestDomain"
                }
              ],
              [
                {
                  "Ref": "Domain"
                }
              ]
            ]
          },
          "Actions": [
            {
              "S3Action": {
                "BucketName": {
                  "Ref": "Inbox"
                },
                "ObjectKeyPrefix": "inbox/"
              }
            }
          ]
        }
      }
    },
    "ForwardRule": {
      "Type": "AWS::SES::ReceiptRule",
      "Condition": "Forwards",
      "DependsOn": [
        "InboxPolicy",
        "ForwarderInvoke"
      ],
      "Properties": {
        "RuleSetName": {
          "Ref": "RuleSet"
        },
        "Rule": {
          "Name": "tower-mail-forward",
          "Enabled": true,
          "ScanEnabled": true,
          "TlsPolicy": "Optional",
          "Recipients": {
            "Fn::If": [
              "HasTestDomain",
              [
                {
                  "Ref": "Domain"
                },
                {
                  "Ref": "TestDomain"
                }
              ],
              [
                {
                  "Ref": "Domain"
                }
              ]
            ]
          },
          "Actions": [
            {
              "S3Action": {
                "BucketName": {
                  "Ref": "Inbox"
                },
                "ObjectKeyPrefix": "inbox/"
              }
            },
            {
              "LambdaAction": {
                "FunctionArn": {
                  "Fn::GetAtt": [
                    "Forwarder",
                    "Arn"
                  ]
                },
                "InvocationType": "Event"
              }
            }
          ]
        }
      }
    },
    "ForwarderLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "Forwards",
      "Properties": {
        "LogGroupName": "/aws/lambda/tower-mail-forwarder",
        "RetentionInDays": 14
      }
    },
    "ForwarderRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "Forwards",
      "Properties": {
        "RoleName": "tower-app-mail-forwarder",
        "Description": "The forwarder reads the stored message and the map and sends as the domain",
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/tower-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "forwarder",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteTheLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ForwarderLogs",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Sid": "ReadTheStoredMessage",
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Inbox.Arn}/inbox/*"
                  }
                },
                {
                  "Sid": "ReadTheMap",
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${MapParameter}"
                  }
                },
                {
                  "Sid": "DecryptTheMapThroughSsm",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                },
                {
                  "Sid": "SendAsTheDomain",
                  "Effect": "Allow",
                  "Action": [
                    "ses:SendEmail",
                    "ses:SendRawEmail"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "ses:FromAddress": {
                        "Fn::Sub": "${SenderLocalPart}@${Domain}"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "Forwarder": {
      "Type": "AWS::Lambda::Function",
      "Condition": "Forwards",
      "Properties": {
        "FunctionName": "tower-mail-forwarder",
        "Description": "Forwards a message SES stored to the destinations the map names for its recipients",
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 60,
        "Role": {
          "Fn::GetAtt": [
            "ForwarderRole",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "import json, os, re\nfrom email.utils import formataddr\nimport boto3\n\nDROP = {b'return-path', b'sender', b'message-id', b'dkim-signature'}\n\n\ndef rewrite(raw, sender, name):\n    \"\"\"The message as the domain sends it on: From is the domain's sender under its display name, Reply-To the original From\n    (unless one is set).\"\"\"\n    cut = re.search(rb'\\r?\\n\\r?\\n', raw)\n    head, body = (raw[:cut.start()], raw[cut.start():]) if cut else (raw, b'')\n    nl = b'\\r\\n' if b'\\r\\n' in head else b'\\n'\n    kept, original, reply = [], b'', False\n    for field in re.split(rb'\\r?\\n(?![ \\t])', head):\n        field_name = field.split(b':', 1)[0].strip().lower()\n        if field_name == b'from':\n            original = field.split(b':', 1)[1].strip()\n        elif field_name not in DROP:\n            reply = reply or field_name == b'reply-to'\n            kept.append(field)\n    lines = [b'From: ' + formataddr((name, sender)).encode()]\n    if original and not reply:\n        lines.append(b'Reply-To: ' + original)\n    return nl.join(lines + kept) + body\n\n\ndef destinations(table, recipients):\n    found = set()\n    for recipient in recipients:\n        recipient = recipient.lower()\n        got = table.get(recipient, table.get(recipient.split('@')[0], []))\n        found.update([got] if isinstance(got, str) else got)\n    return sorted(found)\n\n\ndef handler(event, context):\n    ses = event['Records'][0]['ses']\n    mail, receipt, env = ses['mail'], ses['receipt'], os.environ\n    ident = mail['messageId']\n    if any(receipt.get(k, {}).get('status') == 'FAIL' for k in ('spamVerdict', 'virusVerdict')):\n        print(json.dumps({'message': ident, 'stored': True, 'forwarded': 0, 'why': 'spam or virus verdict'}))\n        return\n    value = boto3.client('ssm').get_parameter(Name=env['MAP'], WithDecryption=True)['Parameter']['Value']\n    to = destinations(json.loads(value or '{}'), receipt['recipients'])\n    if to:\n        raw = boto3.client('s3').get_object(Bucket=env['BUCKET'], Key=env['PREFIX'] + ident)['Body'].read()\n        boto3.client('sesv2').send_email(FromEmailAddress=env['SENDER'], Destination={'ToAddresses': to},\n                                         Content={'Raw': {'Data': rewrite(raw, env['SENDER'], env['SENDER_NAME'])}})\n    print(json.dumps({'message': ident, 'stored': True, 'forwarded': len(to)}))\n"
        },
        "Environment": {
          "Variables": {
            "MAP": {
              "Ref": "MapParameter"
            },
            "BUCKET": {
              "Ref": "Inbox"
            },
            "PREFIX": "inbox/",
            "SENDER": {
              "Fn::Sub": "${SenderLocalPart}@${Domain}"
            },
            "SENDER_NAME": {
              "Ref": "SenderName"
            }
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ForwarderLogs"
          }
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "ForwarderInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "Forwards",
      "Properties": {
        "FunctionName": {
          "Ref": "Forwarder"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "ses.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:receipt-rule-set/tower-mail:receipt-rule/tower-mail-forward"
        }
      }
    }
  },
  "Outputs": {
    "InboxBucket": {
      "Condition": "MailOn",
      "Description": "where SES stores every message (inbox/<message id>), 30 days",
      "Value": {
        "Ref": "Inbox"
      }
    },
    "RuleSetName": {
      "Condition": "MailOn",
      "Description": "the rule set the Torre makes active (set-active-receipt-rule-set)",
      "Value": {
        "Ref": "RuleSet"
      }
    },
    "DkimName1": {
      "Condition": "MailOn",
      "Value": {
        "Fn::GetAtt": [
          "Identity",
          "DkimDNSTokenName1"
        ]
      },
      "Export": {
        "Name": "tower-mail-dkim-name-1"
      }
    },
    "DkimValue1": {
      "Condition": "MailOn",
      "Value": {
        "Fn::GetAtt": [
          "Identity",
          "DkimDNSTokenValue1"
        ]
      },
      "Export": {
        "Name": "tower-mail-dkim-value-1"
      }
    },
    "DkimName2": {
      "Condition": "MailOn",
      "Value": {
        "Fn::GetAtt": [
          "Identity",
          "DkimDNSTokenName2"
        ]
      },
      "Export": {
        "Name": "tower-mail-dkim-name-2"
      }
    },
    "DkimValue2": {
      "Condition": "MailOn",
      "Value": {
        "Fn::GetAtt": [
          "Identity",
          "DkimDNSTokenValue2"
        ]
      },
      "Export": {
        "Name": "tower-mail-dkim-value-2"
      }
    },
    "DkimName3": {
      "Condition": "MailOn",
      "Value": {
        "Fn::GetAtt": [
          "Identity",
          "DkimDNSTokenName3"
        ]
      },
      "Export": {
        "Name": "tower-mail-dkim-name-3"
      }
    },
    "DkimValue3": {
      "Condition": "MailOn",
      "Value": {
        "Fn::GetAtt": [
          "Identity",
          "DkimDNSTokenValue3"
        ]
      },
      "Export": {
        "Name": "tower-mail-dkim-value-3"
      }
    }
  }
}
