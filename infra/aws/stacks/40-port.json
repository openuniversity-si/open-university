{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The port of the infrastructure (P3 F2, D-309): the HTTP API of API Gateway and one zip Lambda behind the alias live (DEP8: the fast deploy swaps that pointer in ~1 s), the port in the private subnets, answering from the database by IAM authentication. GATE-SHUTDOWN: the Origin webhook route, its queues, its ingress and its consumer left the stack (the AWS gate is stopped; AWS keeps the deploy and the site data). Version marker DEP8-ZIP-ALIAS.",
  "Parameters": {
    "InstallationTokenSha256": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/tower/port/installation-token-sha256",
      "Description": "The sha256 of the installation's token, a String the Torre creates; the token itself never reaches AWS"
    },
    "Concurrency": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "Description": "Reserved concurrency of the port, the most database connections it opens at once; 0 reserves none and leaves the port in the account's unreserved pool, which a new account caps at 10 in all (a reservation must leave 10 unreserved, so it waits for a larger quota)"
    },
    "PortCode": {
      "Type": "String",
      "Default": "artifacts/lambda/tower-port-api/unset.zip",
      "Description": "DEP8: the S3 key (in the outputs bucket) of the zip package tower-port-api starts from, passed by infra/aws/deploy.sh (--parameter-overrides, from `lambda_package.py publish`; not SSM); the fast deploy swaps the alias live without touching this"
    },
    "DepsKey": {
      "Type": "String",
      "Default": "artifacts/lambda/deps/unset.zip",
      "Description": "DEP8: the S3 key of the layer with psycopg (infra/service/requirements-lambda.txt), passed by infra/aws/deploy.sh (--parameter-overrides, from `lambda_package.py publish`; not SSM)"
    }
  },
  "Conditions": {
    "ReservesConcurrency": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "Concurrency"
            },
            0
          ]
        }
      ]
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/tower-port",
        "RetentionInDays": 14
      }
    },
    "PortRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tower-app-port",
        "Description": "The port writes its logs, attaches to the VPC and connects to tower-data as tower_service",
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/tower-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "port",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteTheLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Logs",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Sid": "AttachToTheVpc",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "ConnectAsTheServiceLogin",
                  "Effect": "Allow",
                  "Action": "rds-db:connect",
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser:${Instance}/tower_service",
                      {
                        "Instance": {
                          "Fn::ImportValue": "tower-data-resource-id"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "PortFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "tower-port-api",
        "Description": "The port of the infrastructure: commands and queries answered from the database (D-309)",
        "Code": {
          "S3Bucket": {
            "Fn::Sub": "tower-outputs-${AWS::AccountId}-${AWS::Region}"
          },
          "S3Key": {
            "Ref": "PortCode"
          }
        },
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 30,
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "ReservesConcurrency",
            {
              "Ref": "Concurrency"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Role": {
          "Fn::GetAtt": [
            "PortRole",
            "Arn"
          ]
        },
        "VpcConfig": {
          "SubnetIds": {
            "Fn::Split": [
              ",",
              {
                "Fn::ImportValue": "tower-network-private-subnets"
              }
            ]
          },
          "SecurityGroupIds": [
            {
              "Fn::ImportValue": "tower-network-tasks-sg"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "TOWER_DB_HOST": {
              "Fn::ImportValue": "tower-data-endpoint"
            },
            "TOWER_DB_PORT": {
              "Fn::ImportValue": "tower-data-port"
            },
            "TOWER_DB_NAME": {
              "Fn::ImportValue": "tower-data-name"
            },
            "TOWER_DB_USER": "tower_service",
            "TOWER_INSTALLATION_TOKEN_SHA256": {
              "Ref": "InstallationTokenSha256"
            }
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "Logs"
          }
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ],
        "Runtime": "python3.12",
        "Handler": "tower_infra.http_port.handler",
        "Layers": [
          {
            "Ref": "DepsLayer"
          }
        ]
      },
      "DeletionPolicy": "Delete"
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "tower-port",
        "Description": "The port of the infrastructure (P3 F2)",
        "ProtocolType": "HTTP",
        "Tags": {
          "project": "tower"
        }
      }
    },
    "PortIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Ref": "PortAlias"
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 30000
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${PortIntegration}"
        }
      }
    },
    "DefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 10
        }
      }
    },
    "InvokeFromTheApi": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "PortAlias"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    },
    "DepsLayer": {
      "Type": "AWS::Lambda::LayerVersion",
      "Properties": {
        "LayerName": "tower-port-deps",
        "Description": "psycopg for arm64, CPython 3.12, with its bytecode when the deployer has that Python",
        "CompatibleRuntimes": [
          "python3.12"
        ],
        "CompatibleArchitectures": [
          "arm64"
        ],
        "Content": {
          "S3Bucket": {
            "Fn::Sub": "tower-outputs-${AWS::AccountId}-${AWS::Region}"
          },
          "S3Key": {
            "Ref": "DepsKey"
          }
        }
      }
    },
    "PortVersion": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "PortFunction"
        },
        "Description": {
          "Fn::Sub": "slow deploy of ${PortCode} on ${DepsKey} with 256 MB"
        }
      }
    },
    "PortAlias": {
      "Type": "AWS::Lambda::Alias",
      "Properties": {
        "FunctionName": {
          "Ref": "PortFunction"
        },
        "Name": "live",
        "FunctionVersion": {
          "Fn::GetAtt": [
            "PortVersion",
            "Version"
          ]
        },
        "Description": "DEP8: the pointer the fast deploy swaps (UpdateAlias); API Gateway and the service call this alias"
      }
    },
    "PortErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "tower-port-errors",
        "AlarmDescription": "AWS-ALARMS: 5 or more errors of the port Lambda in 5 minutes",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "PortFunction"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:tower-platform-events"
          }
        ],
        "OKActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:tower-platform-events"
          }
        ]
      }
    },
    "PortThrottlesAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "tower-port-throttles",
        "AlarmDescription": "AWS-ALARMS: the port Lambda throttled (its calls were refused)",
        "Namespace": "AWS/Lambda",
        "MetricName": "Throttles",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "PortFunction"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:tower-platform-events"
          }
        ],
        "OKActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:tower-platform-events"
          }
        ]
      }
    },
    "Api5xxAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "tower-port-5xx",
        "AlarmDescription": "AWS-ALARMS: 5 or more 5xx answers of the HTTP API in 5 minutes",
        "Namespace": "AWS/ApiGateway",
        "MetricName": "5xx",
        "Dimensions": [
          {
            "Name": "ApiId",
            "Value": {
              "Ref": "HttpApi"
            }
          },
          {
            "Name": "Stage",
            "Value": "$default"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:tower-platform-events"
          }
        ],
        "OKActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:tower-platform-events"
          }
        ]
      }
    }
  },
  "Outputs": {
    "PortUrl": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      },
      "Export": {
        "Name": "tower-port-url"
      }
    }
  }
}
