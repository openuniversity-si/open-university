{
  "description": "AGENT-ENV (D-341): the resources of one agent environment in infra/aws/stacks/45-agent-env.json, which scripts/lib/agent_env_stack.py renders once per declaration of config/agent-env/: @ID@ is its id, @KEY@ its logical-id prefix, @PREFIX@ its SSM prefix and @PATH@ that prefix without its last slash; the code (@CODE@, infra/aws/agent-env/handler.py) and the environment (@ENVIRONMENT@) are filled in by the generator.",
  "zipfile_limit": 4096,
  "Description": "AGENT-ENV (D-341): one Lambda per agent environment declared in config/agent-env/, outside the VPC, behind its own route on the port's HTTP API; it checks the sha256 of the bearer against its SSM String token-sha256 and answers the declared variables and its SSM SecureString secrets, refusing the whole bundle on a denied or undeclared name. The Torre relay tower-app-torre-relay, the one role that reads the Torre's webhook secrets, forwards an authenticated session's text on POST <endpoint>/v1/torre, one call per agent-env.torre_window_s per environment. Generated by scripts/lib/agent_env_stack.py; never edited by hand. Lambda and the route cost under US$ 0.05 a month.",
  "Resources": {
    "@KEY@Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/tower-app-agent-env-@ID@",
        "RetentionInDays": 14
      }
    },
    "@KEY@Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tower-app-agent-env-@ID@",
        "Description": "AGENT-ENV @ID@: reads its own SSM prefix @PREFIX@ alone (D-341)",
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/tower-boundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "agent-env",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteTheLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "@KEY@Logs",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Sid": "ReadItsOwnParameters",
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParametersByPath"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter@PATH@"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter@PREFIX@*"
                    }
                  ]
                },
                {
                  "Sid": "DecryptThroughSsmOnly",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${AWS::Region}:${AWS::AccountId}:key/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "@KEY@Function": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "tower-app-agent-env-@ID@",
        "Description": "AGENT-ENV @ID@: the bundle its declaration lists, from SSM (D-341)",
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 128,
        "Timeout": 10,
        "Role": {
          "Fn::GetAtt": [
            "@KEY@Role",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "@CODE@"
        },
        "Environment": {
          "Variables": "@ENVIRONMENT@"
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "@KEY@Logs"
          }
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "tower"
          }
        ]
      }
    },
    "@KEY@Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Fn::ImportValue": "tower-port-api-id"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "@KEY@Function",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 10000
      }
    },
    "@KEY@Route": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Fn::ImportValue": "tower-port-api-id"
        },
        "RouteKey": "GET /agent-env/@ID@/v1/agent-env",
        "Target": {
          "Fn::Sub": "integrations/${@KEY@Integration}"
        }
      }
    },
    "@KEY@Invoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "@KEY@Function"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*/GET/agent-env/@ID@/v1/agent-env",
            {
              "Api": {
                "Fn::ImportValue": "tower-port-api-id"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "@KEY@Endpoint": {
      "Description": "agent-env.endpoint of @ID@",
      "Value": {
        "Fn::Sub": [
          "${Url}/agent-env/@ID@",
          {
            "Url": {
              "Fn::ImportValue": "tower-port-url"
            }
          }
        ]
      }
    }
  }
}
