{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/budgets/baseline.v1.json",
  "title": "Performance baseline v1",
  "description": "The committed baseline of config/baselines/budgets.json: the p95 of each budgeted metric, computed from the event log by scripts/budgets baseline. Never hand-written.",
  "x-owner": "budgets",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "percentile", "window_samples", "metrics"],
  "properties": {
    "version": {"const": 1},
    "percentile": {"type": "integer", "minimum": 1, "maximum": 100},
    "window_samples": {"type": "integer", "minimum": 1},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "subject", "value", "samples", "evidence"],
        "properties": {
          "metric": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"},
          "subject": {"type": "string", "minLength": 1},
          "value": {"type": "number", "minimum": 0},
          "samples": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string", "minLength": 1, "description": "event_id of the newest measurement the value rests on."}
        }
      }
    }
  }
}
