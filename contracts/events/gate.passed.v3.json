{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/gate.passed.v3.json",
  "title": "gate.passed payload v3",
  "description": "Tier-1 (or other plan) gate verdict on a PR head; THE gate evidence (D-065), emitted by gate_report. v2 (GS1) adds the cached script tests. v3 (KD1) adds the known base defects the verdict excused.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha",
    "/payload/plan",
    "/payload/input_hash"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "tier",
    "plan",
    "stages",
    "missing_stages",
    "input_hash"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "tier": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Gate tier (1 = per-PR gate-dev); null for other plans."
    },
    "plan": {
      "type": "string",
      "minLength": 1,
      "description": "The gate mode that ran (dev, db, noite, ...)."
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "defs.v1.json#/$defs/stage"
      },
      "description": "Every stage that ran, with its time and class."
    },
    "missing_stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Stages the plan expected that did not pass."
    },
    "input_hash": {
      "$ref": "defs.v1.json#/$defs/sha256",
      "description": "sha256 of the judged commit, the plan and its expected stages."
    },
    "cached_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cached_test"
      },
      "description": "Script tests reported as cached PASS: the id, the key that matched and the run that recorded the PASS."
    },
    "known_defects": {
      "type": "array",
      "description": "Failing tests that fail on the integration base with the same signature: base defects, listed and not blocking.",
      "items": {
        "$ref": "#/$defs/known_defect"
      }
    }
  },
  "$defs": {
    "cached_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The script test reported as a cached PASS."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "The input-hash key that matched the recorded PASS."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "The run (commit) that recorded the PASS."
        }
      }
    },
    "known_defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "signature",
        "base_sha",
        "defect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The failing test id."
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string"
        },
        "base_sha": {
          "$ref": "defs.v1.json#/$defs/commit"
        },
        "defect": {
          "type": "string",
          "pattern": "^KD-[0-9a-f]{6,}$"
        }
      }
    }
  }
}
