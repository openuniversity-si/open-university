{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/premise.review.due.v1.json",
  "title": "premise.review.due payload v1",
  "description": "A merge carried MEDIUM or LOW unconfirmed premises; A Torre reviews them in a batch.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "pending"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "pending": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "defs.v1.json#/$defs/premise_id"
      }
    }
  }
}
