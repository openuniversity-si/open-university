{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/contract.retired.v1.json",
  "title": "contract.retired payload v1",
  "description": "A unit contract symbol is retired; consuming lanes migrate.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/unit",
    "/payload/symbol",
    "/payload/version"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "symbol",
    "version"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
