{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/selection.escape.v1.json",
  "title": "selection.escape payload v1",
  "description": "Tier 2 failed a test tier 1 did not select for the PR.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha",
    "/payload/test"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "test"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "test": {
      "type": "string",
      "minLength": 1
    }
  }
}
