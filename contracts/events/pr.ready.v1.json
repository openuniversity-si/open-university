{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/pr.ready.v1.json",
  "title": "pr.ready payload v1",
  "description": "A PR whose head passed the gate with a valid body asks the train to queue it.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "lane_id",
    "evidence"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "lane_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "$ref": "defs.v1.json#/$defs/sha256",
      "description": "event_id of the gate.passed this rests on."
    }
  }
}
