{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/unit.addressable.v1.json",
  "title": "unit.addressable payload v1",
  "description": "Every importer of unit uses @ou/<id> at sha; the unit may move.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/unit",
    "/payload/sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    }
  }
}
