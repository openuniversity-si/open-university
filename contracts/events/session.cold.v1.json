{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/session.cold.v1.json",
  "title": "session.cold payload v1",
  "description": "A session measured its start-up time.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/session_id"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "session_id",
    "setup_ms"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "setup_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
