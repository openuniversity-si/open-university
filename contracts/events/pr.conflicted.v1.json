{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/pr.conflicted.v1.json",
  "title": "pr.conflicted payload v1",
  "description": "The train could not merge the PR onto the tip; the lane resyncs.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha",
    "/payload/tip_sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "files",
    "tip_sha"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tip_sha": {
      "$ref": "defs.v1.json#/$defs/commit"
    }
  }
}
