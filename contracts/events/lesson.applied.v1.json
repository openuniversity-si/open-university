{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/lesson.applied.v1.json",
  "title": "lesson.applied payload v1",
  "description": "A lesson became applied: the change it asks for is in the engine. The effect is measured from this moment.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/lesson"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "lesson",
    "class",
    "kind",
    "owner",
    "applied_pr",
    "ref"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "lesson": {
      "type": "string",
      "pattern": "^LR-[0-9a-f]{6,}$"
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "applied_pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
