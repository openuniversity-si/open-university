{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/pr.checked.v1.json",
  "title": "pr.checked payload v1",
  "description": "The PR-metadata verdict (commit plan, pushes, comments, premises line), bound to a head. It changes without a new head, so it is a separate, cheap event next to the gate verdict (GX-37; produced by GX-15).",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha",
    "/payload/base_sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "base_sha",
    "result",
    "errors"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "base_sha": {
      "$ref": "defs.v1.json#/$defs/commit"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "One line per refusal; empty on pass."
    }
  }
}
