{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/base.red.v1.json",
  "title": "base.red payload v1",
  "description": "Tier 3 saw the base tip red: the failing tests of any stage kind, for adjudication to excuse (GX-37; produced by GX-32).",
  "x-natural-key": [
    "/payload/repo",
    "/payload/base_sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "base_sha",
    "tests",
    "since"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "The PR; null on the repository channel."
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "base_sha": {
      "$ref": "defs.v1.json#/$defs/commit"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stage",
          "signature"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string"
          }
        }
      }
    },
    "since": {
      "$ref": "defs.v1.json#/$defs/commit",
      "description": "First base commit where the tests were seen red."
    }
  }
}
