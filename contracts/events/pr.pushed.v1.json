{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/pr.pushed.v1.json",
  "title": "pr.pushed payload v1",
  "description": "A new head (sha) was pushed; the PR leaves the train queue until a new pr.ready.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    }
  }
}
