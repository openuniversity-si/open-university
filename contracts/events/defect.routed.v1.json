{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/defect.routed.v1.json",
  "title": "defect.routed payload v1",
  "description": "The router opened a fix unit for the defect's owner and listed the units that touch its area; those depend on the fix unit, the others proceed. Priority is queue impact, never a deadline.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/defect",
    "/payload/fix_item"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "defect",
    "test",
    "signature",
    "owner",
    "priority",
    "class",
    "fix_item",
    "work_event",
    "touching",
    "dependents",
    "masked"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "defect": {
      "type": "string",
      "pattern": "^KD-[0-9a-f]{6,}$"
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "fix_item": {
      "type": "string",
      "minLength": 1
    },
    "work_event": {
      "type": "string",
      "minLength": 1
    },
    "touching": {
      "$ref": "defs.v1.json#/$defs/prs"
    },
    "dependents": {
      "$ref": "defs.v1.json#/$defs/prs"
    },
    "masked": {
      "type": "integer",
      "minimum": 0
    }
  }
}
