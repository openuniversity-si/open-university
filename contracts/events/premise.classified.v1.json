{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/premise.classified.v1.json",
  "title": "premise.classified payload v1",
  "description": "The tool computed a premise blast radius.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/premise_id",
    "/payload/level"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "premise_id",
    "level",
    "reasons"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "premise_id": {
      "$ref": "defs.v1.json#/$defs/premise_id"
    },
    "level": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
