{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/lesson.recorded.v1.json",
  "title": "lesson.recorded payload v1",
  "description": "The lessons registry recorded a lesson (status proposed) from a unit retro.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/lesson"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "lesson",
    "class",
    "kind",
    "owner",
    "source_unit"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "lesson": {
      "type": "string",
      "pattern": "^LR-[0-9a-f]{6,}$"
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source_unit": {
      "type": "string",
      "minLength": 1
    }
  }
}
