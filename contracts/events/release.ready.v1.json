{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/release.ready.v1.json",
  "title": "release.ready payload v1",
  "description": "The battery is green on tip sha and the release criterion holds.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "prs",
    "prs_since_release"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "prs": {
      "$ref": "defs.v1.json#/$defs/prs"
    },
    "prs_since_release": {
      "type": "integer",
      "minimum": 0
    }
  }
}
