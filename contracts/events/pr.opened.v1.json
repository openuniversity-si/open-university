{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/pr.opened.v1.json",
  "title": "pr.opened payload v1",
  "description": "A change was opened; sha is its head. Ownership is checked from the body.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "base_sha",
    "lane_id",
    "units"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "base_sha": {
      "$ref": "defs.v1.json#/$defs/commit"
    },
    "lane_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  }
}
