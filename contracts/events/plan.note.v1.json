{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/plan.note.v1.json",
  "title": "plan.note payload v1",
  "description": "A running session passed information on to the planner with scripts/plan note and kept going (live-planning design 1.3).",
  "x-owner": "live-planning",
  "x-schema-version": 1,
  "x-natural-key": [
    "/payload/repo",
    "/payload/program",
    "/payload/from_unit",
    "/payload/kind",
    "/payload/evidence",
    "/payload/text"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "program",
    "from_unit",
    "affects",
    "kind",
    "evidence",
    "text"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "program": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Program id (docs/programs/<program>/plan.md program.v1)."
    },
    "from_unit": {
      "type": "string",
      "minLength": 1,
      "description": "The unit that found it."
    },
    "affects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Unit ids, area names, or the single entry all."
    },
    "kind": {
      "type": "string",
      "enum": [
        "blocker",
        "lesson",
        "premise",
        "estimate",
        "engine"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "description": "A ref: PR, commit, event id, log path."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "One line."
    }
  }
}
