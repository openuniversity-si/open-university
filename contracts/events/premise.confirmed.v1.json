{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/premise.confirmed.v1.json",
  "title": "premise.confirmed v1 payload",
  "description": "A premise was confirmed by an answer or validated by a measurement (D-066).",
  "x-owner": "premises",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "by",
    "at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P-[0-9]{2,}$",
      "description": "Premise id."
    },
    "status": {
      "type": "string",
      "description": "One of config premises.settled_statuses."
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": [
        "string",
        "null"
      ],
      "description": "RFC 3339 time of the answer, or null when the source gives none."
    },
    "quote": {
      "type": [
        "string",
        "null"
      ]
    },
    "where": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
