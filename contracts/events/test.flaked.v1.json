{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/test.flaked.v1.json",
  "title": "test.flaked payload v1",
  "description": "A test failed and passed on the same sha; it goes to quarantine with an owner (D-025).",
  "x-natural-key": [
    "/payload/repo",
    "/payload/sha",
    "/payload/test"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "test",
    "log"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "log": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
