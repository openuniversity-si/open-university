{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/common-key.requested.v1.json",
  "title": "common-key.requested payload v1",
  "description": "A session asks the kernel lane for a common key.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/value"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "value",
    "areas"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
