{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/premise.proposed.v1.json",
  "title": "premise.proposed v1 payload",
  "description": "A premise was registered by scripts/premises propose (D-066). Envelope: contracts/events/envelope.v1.json.",
  "x-owner": "premises",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "statement",
    "kind",
    "scope",
    "source",
    "radius",
    "reasons"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P-[0-9]{2,}$",
      "description": "Premise id."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "who"
      ],
      "properties": {
        "who": {
          "type": "string",
          "minLength": 1
        },
        "where": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "radius": {
      "type": "string",
      "description": "One of config premises.radii."
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+:\\S"
      },
      "uniqueItems": true,
      "description": "Blast reasons as <kind>:<target>, e.g. decision:D-065."
    }
  }
}
