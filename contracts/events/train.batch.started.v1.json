{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/train.batch.started.v1.json",
  "title": "train.batch.started payload v1",
  "description": "The train started a batch on tip sha.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/batch_id"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "batch_id",
    "prs"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "prs": {
      "$ref": "defs.v1.json#/$defs/prs"
    }
  }
}
