{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/env.drift.v1.json",
  "title": "env.drift payload v1",
  "description": "A gate stage failed with class env; the env lane opens a patch PR.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/pr",
    "/payload/sha",
    "/payload/stage"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "stage",
    "tool",
    "versions"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
