{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/test.unquarantined.v1.json",
  "title": "test.unquarantined payload v1",
  "description": "The owner's stabilizing PR merged (its body names the test on a Stabilizes: line): the quarantine it names ends. Repository channel: pr is null and sha is the merge commit.",
  "x-natural-key": [
    "/payload/repo",
    "/payload/test",
    "/payload/quarantined_event"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr",
    "sha",
    "unit",
    "premises",
    "test",
    "owner",
    "quarantined_event",
    "stabilizing_pr"
  ],
  "properties": {
    "repo": {
      "$ref": "defs.v1.json#/$defs/repo"
    },
    "pr": {
      "$ref": "defs.v1.json#/$defs/pr"
    },
    "sha": {
      "$ref": "defs.v1.json#/$defs/sha"
    },
    "unit": {
      "$ref": "defs.v1.json#/$defs/unit"
    },
    "premises": {
      "$ref": "defs.v1.json#/$defs/premises"
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "quarantined_event": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "event_id of the test.quarantined this event ends."
    },
    "stabilizing_pr": {
      "type": "integer",
      "minimum": 1,
      "description": "The merged PR that stabilized the test."
    }
  }
}
