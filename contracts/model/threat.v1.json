{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/model/threat.v1.json",
  "title": "Threat model v1",
  "description": "config/security/threats/<id>.json (PADRAO-DEV F7d, D-321): the threat model of one architecture element (SDL): its assets, trust boundaries, entry points and the threats (STRIDE) with their mitigations. It models an ARC and turns suspect when the ARC changes.",
  "x-owner": "model",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "models",
    "assets",
    "boundaries",
    "threats"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^THREAT-[a-z0-9][a-z0-9-]*$"
    },
    "models": {
      "type": "string",
      "pattern": "^ARC-[a-z0-9][a-z0-9-]*$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stride",
          "statement"
        ],
        "properties": {
          "stride": {
            "enum": [
              "spoofing",
              "tampering",
              "repudiation",
              "information-disclosure",
              "denial-of-service",
              "elevation-of-privilege"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "mitigated_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "The date (UTC) a reviewer other than the model's author accepted the model as it stands: set only when no finding of `review` is open."
    },
    "review": {
      "type": "object",
      "description": "The latest independent review of the model (SSDF PW.2): who reviewed it, on which date, and every finding with its disposition. A model with an open finding carries `review` and no `reviewed`, so it stays written (under review).",
      "additionalProperties": false,
      "required": [
        "by",
        "on",
        "findings"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "about",
              "finding",
              "disposition"
            ],
            "properties": {
              "about": {
                "enum": [
                  "assets",
                  "boundaries",
                  "spoofing",
                  "tampering",
                  "repudiation",
                  "information-disclosure",
                  "denial-of-service",
                  "elevation-of-privilege"
                ]
              },
              "finding": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "fixed",
                  "accepted",
                  "open"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "target_fingerprints": {
      "type": "object",
      "description": "Content fingerprints of linked targets verified when this threat model was last stamped (scripts/model stamp); a mismatch marks the link suspect.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{12}$"
      }
    }
  }
}
