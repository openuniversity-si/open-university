{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/model/conformance.v1.json",
  "title": "Model conformance scale v1",
  "description": "config/model/conformance.json (PADRAO-DEV F1): the rating scale of a calculated conformance, as levels with the upper bound of the share each covers.",
  "x-owner": "model",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "scale"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "up_to"
        ],
        "properties": {
          "level": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "up_to": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
