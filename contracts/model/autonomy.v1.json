{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/model/autonomy.v1.json",
  "title": "Autonomy ladder and external trust indicators v1",
  "description": "config/governance/autonomy-ladder.json (D-353, proposed): scope-calibrated autonomy ladder (levels A, B, C), eight external trust indicators computed from non-self-reported repository and CI/production artifacts, automatic demotion circuit breakers, and owner-locked domains that never become autonomous without explicit approval.",
  "x-owner": "model",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "state",
    "decision",
    "owner",
    "description",
    "defaults",
    "indicators",
    "levels",
    "circuit_breakers",
    "always_owner_locked",
    "history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AUTONOMY-[a-z0-9][a-z0-9-]*$"
    },
    "state": {
      "enum": [
        "proposed",
        "active",
        "superseded"
      ],
      "description": "proposed: awaiting explicit owner decision; active: adopted by the owner; superseded: replaced by a later ladder."
    },
    "decision": {
      "type": "string",
      "pattern": "^D-[0-9]+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rework_window_prs",
        "split_window_seconds",
        "snapshot_max_age_days",
        "snapshot_max_merges_behind",
        "override_normalization_prs",
        "diagnostic_percentiles",
        "max_window_merges",
        "product_prefixes",
        "capacity_prefixes",
        "meta_governance_prefixes",
        "meta_governance_files",
        "session_authority_markers",
        "owner_authority_markers",
        "high_severities",
        "dockerfile_names",
        "expected_ecosystems"
      ],
      "properties": {
        "rework_window_prs": {
          "type": "integer",
          "minimum": 1
        },
        "split_window_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "snapshot_max_age_days": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_max_merges_behind": {
          "type": "integer",
          "minimum": 1
        },
        "override_normalization_prs": {
          "type": "integer",
          "minimum": 1
        },
        "diagnostic_percentiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "max_window_merges": {
          "type": "integer",
          "minimum": 1
        },
        "product_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capacity_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "meta_governance_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "meta_governance_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_authority_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_authority_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "high_severities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dockerfile_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_ecosystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "indicators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_integrity",
        "change_failure_rework",
        "first_pass_yield",
        "independent_audit",
        "human_override_rate",
        "signal_to_overhead",
        "production_health_and_cost",
        "security_posture"
      ],
      "properties": {
        "main_integrity": {
          "$ref": "#/$defs/indicator"
        },
        "change_failure_rework": {
          "$ref": "#/$defs/indicator"
        },
        "first_pass_yield": {
          "$ref": "#/$defs/indicator"
        },
        "independent_audit": {
          "$ref": "#/$defs/indicator"
        },
        "human_override_rate": {
          "$ref": "#/$defs/indicator"
        },
        "signal_to_overhead": {
          "$ref": "#/$defs/indicator"
        },
        "production_health_and_cost": {
          "$ref": "#/$defs/indicator"
        },
        "security_posture": {
          "$ref": "#/$defs/indicator"
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "name",
          "feng_role",
          "scope",
          "prerequisite_level",
          "promotion_days",
          "required_indicators",
          "excluded_paths"
        ],
        "properties": {
          "level": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "feng_role": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "prerequisite_level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "A",
              "B"
            ]
          },
          "promotion_days": {
            "type": "integer",
            "minimum": 1
          },
          "required_indicators": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/indicator_id"
            }
          },
          "excluded_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extra_guards": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_overrides_per_50_prs": {
                "type": "number",
                "minimum": 0
              },
              "max_gaming_cases": {
                "type": "integer",
                "minimum": 0
              },
              "max_sequential_same_scope_splits": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "circuit_breakers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "indicator",
          "action",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CB-[a-z0-9][a-z0-9-]*$"
          },
          "indicator": {
            "$ref": "#/$defs/indicator_id"
          },
          "action": {
            "enum": [
              "demote_to_none"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "always_owner_locked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LOCK-[a-z0-9][a-z0-9-]*$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "indicators_met",
          "circuit_breakers_tripped",
          "source"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "indicators_met": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/indicator_id"
            }
          },
          "circuit_breakers_tripped": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/indicator_id"
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "indicator_id": {
      "enum": [
        "main_integrity",
        "change_failure_rework",
        "first_pass_yield",
        "independent_audit",
        "human_override_rate",
        "signal_to_overhead",
        "production_health_and_cost",
        "security_posture"
      ]
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "dimension",
        "external_source",
        "sources",
        "target"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "external_source": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "integer",
              "boolean",
              "string"
            ]
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
