{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/model/architecture-import.v1.json",
  "title": "Architecture import v1",
  "description": "config/architecture/imports/<source>.json (PADRAO-DEV F3a): how the architecture elements of one source (the capabilities) are read where they are. It declares what the source does not say: the owner, the requirements each satisfies, and the state and retiring decision of the elements that left.",
  "x-owner": "model",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "satisfies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^REQ-[a-z0-9][a-z0-9.-]*$"
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "proposed",
              "active",
              "deprecated",
              "retired"
            ]
          },
          "retired_by": {
            "type": "string",
            "pattern": "^D-[0-9]+$"
          }
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
