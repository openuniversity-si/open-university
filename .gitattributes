# .gitattributes is an order-free list of lines that every lane appends to at the last line: union keeps both appends.
.gitattributes merge=union
# DOCS-UNION: the AWS board (its rows) and notes (their paragraphs) gain an entry at the same place in every PR: union
# keeps both sides' lines, so a branch whose base moved still merges (the service's base merge said conflict on #648).
docs/operations/aws-pendencias.md merge=union
docs/operations/aws.md merge=union
# A unit's manifest and a registry key file are hand-written JSON whose lists every lane appends to (`requires`,
# `x-readers`): two appends after the same last line both rewrite it for its comma. The same driver merges a path that
# is no generate target structurally when the plain 3-way merge conflicts (merge_regenerate.merge_json).
units/*/unit.json merge=regenerate
config/registry/*/*.json merge=regenerate
